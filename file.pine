//@version=5
indicator("7Seas_PAC", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=200)

// =====================================================================
//  INPUT
// =====================================================================
inputToleransiAvg = 100

wickPct = 50
reqDrop = true

// Group Penanda
markerColor = color.yellow
showArrow = input.bool(true, "Tampilkan Panah", group="Penanda")

// group AVG Body
limitCandleAvg = input.int(100,"Berapa jumlah candle stick utk AVG Body (terhitung dri candle) ?",minval=1,step=1,group="Avg Body")

inputSensitifitas = input.string(
     "LOW",
     "Pilih Sensitifitas",
     options = ["LOW", "MEDIUM", "HIGH"],
     group = "Sensitifitas")

showDebugLegin = input.bool(false, "DEBUG", group="Debug")
devMode = input.bool(false, "DEV MODE", group="Debug", tooltip="Centang: error kode 4 (jarak base > 50% body leg in/out) TIDAK mandatory, hanya jadi pengurang grade.\nUncheck: error kode 4 MANDATORY, pola dibuang kalau jarak base melebihi 50%.")

jmlLabel       = input.int(100, "Jumlah label debug", minval=1, maxval=400, group="Debug")
geserKiri      = input.int(0, "Geser ke kiri (jumlah bar)", minval=0, group="Debug")

// group Swing
showSwing     = input.bool(true, "Tampilkan Zigzag Swing", group="Swing")
// swingLookback = input.int(200, "Lookback (jumlah candle)", minval=20, group="Swing")
swingMinBars  = 3
swingHighCol  = color.red
swingLowCol   = color.lime
zzLineCol     = color.white
lastSHLineCol = color.rgb(255, 105, 180)
lastSLLineCol = color.lime

showLastSH   = input.bool(true, "Garis horizontal Swing High terakhir", group="Swing")
showLastSL    = input.bool(true, "Garis horizontal Swing Low terakhir (RBR)", group="Swing")
swingBasis = input.string("Ekor", "Swing High/Low diambil dari", options=["Body", "Ekor"], group="Swing")

showDbdSingle   = input.bool(true, "Tampilkan DBD Single", group="Penanda")
showRbrSingle = input.bool(true, "Tampilkan RBR Single", group="Penanda")
showDbdMultiple = input.bool(true, "Tampilkan DBD Multiple", group="Penanda")
showRbrMultiple = input.bool(true, "Tampilkan RBR Multiple", group="Penanda")
backtestMode = input.bool(true, "Backtest Mode (buang zona yang sudah tersentuh harga)", group="Penanda")

inputMinGrade = input.string("K", "Grade minimum yang ditampilkan", options=["A","B","C","D","E","F","G","H","I","J","K"], group="Sensitifitas", tooltip="Pilih C: tampil C, B, A. Pilih B: tampil B, A. K = tampilkan semua.")
inputTinggiBodyBase = input.bool(true, "Tinggi body base vs legin/legout (body base tidak boleh lebih besar)", group="Base")

// group Fibonacci
fibTopCol = input.color(color.rgb(255, 105, 180), "Warna zona atas (dari garis Control SH)", group="Fibonacci")
fibBotCol = input.color(color.lime, "Warna zona bawah (dari garis Control RBR)", group="Fibonacci")

var box   fibTopBox = na
var box   fibBotBox = na
var line  tpLine    = na
var label tpLabel   = na

if inputSensitifitas == "MEDIUM"
    wickPct := 60

if inputSensitifitas == "HIGH"
    wickPct := 70
// =====================================================================
//  FUNGSI DASAR (bisa dipakai ulang di indikator lain)
//  Parameter: o = open, h = high, l = low, c = close
// =====================================================================

// Konstanta Candle base
MIN_BASE_T5 = 2
MAX_BASE_T5 = 6



// Ukuran body candle
f_body(float o, float c) =>
    math.abs(c - o)

// Panjang ekor atas
f_upperWick(float o, float h, float c) =>
    h - math.max(o, c)

// Panjang ekor bawah
f_lowerWick(float o, float l, float c) =>
    math.min(o, c) - l

// Total ekor (atas + bawah)
f_totalWick(float o, float h, float l, float c) =>
    f_upperWick(o, h, c) + f_lowerWick(o, l, c)

// Candle drop / bearish
f_isDrop(float o, float c) =>
    c <= o

// Candle naik / bullish
f_isBullish(float o, float c) =>
    c >= o

f_convertPip(float angka) =>
    float hasil = 0.0

    if str.contains(syminfo.ticker, "JPY")
        hasil := math.round(angka * 100)
    else if str.contains(syminfo.ticker, "XAU")
        hasil := math.round(angka * 1)
    else
        hasil := math.round(angka * 10000)

    hasil

// Body minimal pct% dari total ekor
//   Contoh pct = 60 -> body >= 60% x total ekor
f_bodyVsWick(float o, float h, float l, float c, float pct) =>
    f_body(o, c) >= f_totalWick(o, h, l, c) * 1


// f_avgBodyInPrice(int limitCandle, string mode, int offset) =>
//     float totalBody = 0.0
//     if mode == 'dbd'
//         for i = 1 + offset to limitCandle + offset
//             totalBody += math.abs(close[i] - open[i])
//     totalBody / limitCandle

// Rata-rata body, hanya dari candle yang body-nya > total ekor
// Window tetap limitCandle candle (mulai dari [1 + offset])
f_avgBodyInPrice(int limitCandle, string mode, int offset) =>
    float totalBody = 0.0
    int   count     = 0

    if mode == 'dbd'
        for i = 1 + offset to limitCandle + offset
            float body = math.abs(close[i] - open[i])
            float ekor = f_totalWick(open[i], high[i], low[i], close[i])

            // seleksi: hanya candle dengan body lebih besar dari ekor
            if body > ekor
                totalBody += body
                count += 1

    count > 0 ? totalBody / count : 0.0

f_wickVsBody(float o, float h, float l, float c, float pct, offset) =>

    body = f_body(o, c)

    if f_convertPip(f_body(o, c)) < f_convertPip(f_avgBodyInPrice(limitCandleAvg, 'dbd', offset))
        true
    else if f_convertPip(f_totalWick(o, h, l, c) ) >= f_convertPip(f_body(o, c))
        true
    else if f_isBullish(o, c) and f_convertPip(f_body(o,c)) >  f_convertPip(f_totalWick(o, h, l, c))
        true
    else
        false

f_wickVsBodySingle(float o, float h, float l, float c, float pct, int offset) =>
    f_convertPip(f_body(o, c)) < f_convertPip(f_avgBodyInPrice(limitCandleAvg, 'dbd', offset)) or
     f_convertPip(f_totalWick(o, h, l, c)) >= f_convertPip(f_body(o, c)) or
     (f_isBullish(o, c) and f_convertPip(f_body(o, c)) > f_convertPip(f_totalWick(o, h, l, c)))

// Candle base RBR (multiple): tidak boleh turun
// Lolos kalau body kecil (< AVG) atau ekor >= body.
// Candle bearish dengan body besar TIDAK lolos.
f_wickVsBodyBaseRbr(float o, float h, float l, float c, float pct, int offset) =>
    f_convertPip(f_body(o, c)) < f_convertPip(f_avgBodyInPrice(limitCandleAvg, 'dbd', offset)) or
     f_convertPip(f_totalWick(o, h, l, c)) >= f_convertPip(f_body(o, c)) or
     (f_isBullish(o, c) and f_convertPip(f_body(o, c)) > f_convertPip(f_totalWick(o, h, l, c)))

// Kode error 9: semua ekor atas base harus <= open leg in
// false berarti ada base yang ekor atasnya menembus open leg in
f_baseAtasOk(int nBase) =>
    float openLegIn = open[nBase + 2]
    bool ok = true
    for j = 2 to nBase + 1
        if high[j] > openLegIn
            ok := false
    ok

// Kode error 10: semua ekor bawah base harus >= low leg out
// false berarti ada base yang ekor bawahnya turun melewati low leg out
f_baseBawahOk(int nBase) =>
    float lowLegOut = low[1]
    bool ok = true
    for j = 2 to nBase + 1
        if low[j] < lowLegOut
            ok := false
    ok

// Validasi base:
//  Per candle:
//   - wickOk   : lolos f_wickVsBody
//   - atasOk   : ekor atas <= open leg in
//   - bawahOk  : ekor bawah >= low leg out
//   - bullishOk: base bullish, close <= open leg in
//  Keseluruhan:
//   - jarak base (puncak body - dasar body) <= 50% body leg in DAN leg out
f_baseMultiple(int nBase, float pct) =>
    bool perCandleOk = true

    for j = 2 to nBase + 1
        bool wickOk = f_wickVsBody(open[j], high[j], low[j], close[j], pct, j)

        if not wickOk
            perCandleOk := false

    perCandleOk

// Jarak base = puncak body tertinggi - dasar body terendah di semua candle base
// Base ada di [2] .. [nBase+1]
f_jarakBase(int nBase) =>
    float puncak = na
    float dasar  = na
    for j = 2 to nBase + 1
        float atasBody  = math.max(open[j], close[j])
        float bawahBody = math.min(open[j], close[j])
        puncak := na(puncak) ? atasBody  : math.max(puncak, atasBody)
        dasar  := na(dasar)  ? bawahBody : math.min(dasar,  bawahBody)
    puncak - dasar

// true kalau jarak base <= maxRasio x body leg in DAN body leg out
// Contoh maxRasio = 0.5 (50%) atau 0.7 (70%)
f_jarakBaseOk(int nBase, float maxRasio) =>
    float jarak      = f_jarakBase(nBase)
    float bodyLegIn  = f_body(open[nBase + 2], close[nBase + 2])
    float bodyLegOut = f_body(open[1], close[1])
    jarak <= bodyLegIn * maxRasio and jarak <= bodyLegOut * maxRasio

// Validasi MANDATORY (bisa di-toggle): body tiap candle base tidak boleh
// lebih besar dari body leg in ATAU body leg out.
// Base ada di [2] .. [nBase+1], leg out = [1], leg in = [nBase+2]
// Single = nBase 1. Dipakai untuk DBD maupun RBR.
f_baseBodyOk(int nBase) =>
    bool ok = true
    if inputTinggiBodyBase
        float bodyLegIn  = f_body(open[nBase + 2], close[nBase + 2])
        float bodyLegOut = f_body(open[1], close[1])
        for j = 2 to nBase + 1
            float bodyBase = f_body(open[j], close[j])
            if bodyBase > bodyLegIn or bodyBase > bodyLegOut
                ok := false
    ok

f_baseTop(int nBase) =>
    float t = high[2]
    for j = 3 to nBase + 1
        t := math.max(t, high[j])
    t

f_baseBottom(int nBase) =>
    float b = low[2]
    for j = 3 to nBase + 1
        b := math.min(b, low[j])
    b

// true kalau body candle >= rata-rata body (dipakai sebagai error code 5)
f_bodyAvgOk(float o, float c, int offset) =>
    f_convertPip(f_body(o, c)) >= f_convertPip(f_avgBodyInPrice(limitCandleAvg, 'dbd', offset))

// Kode error 7: body leg in >= total ekor leg in
// false berarti ekor leg in lebih panjang daripada body
f_legInBodyOk(float o, float h, float l, float c) =>
    f_convertPip(f_body(o, c)) >= f_convertPip(f_totalWick(o, h, l, c))
        
f_legIn_valid(float o, float h, float l, float c, float toleransi_persen, string mode, int offset) =>
    if mode == 'dbd' and inputSensitifitas == 'HIGH'
        f_isDrop(o, c) and f_body(o, c) > f_totalWick(o, h, l, c)

    else if mode == 'dbd' and inputSensitifitas == 'MEDIUM'
        f_isDrop(o, c) and f_body(o, c) >= f_totalWick(o, h, l, c)

    else if mode == 'dbd' and inputSensitifitas == 'LOW'
        f_isDrop(o, c)          // syarat body vs ekor dipindah ke error code 7

    else
        false


// =====================================================================
// FVG LEG IN DBD
// =====================================================================
// Acuan utama : Candle 1
//
// Candle 1 = [2]
//
// Candle kiri  = [3] → ambil LOW
// Candle kanan = [1] → ambil HIGH
//
// FVG bearish valid apabila:
// LOW candle kiri > HIGH candle kanan
//
// Return:
// true  = FVG Leg In valid
// false = FVG Leg In tidak valid
// =====================================================================
f_fvg_legin_dbd(float lowLeftLegIn, float highRightLegIn) =>
    // lowLeftLegIn > highRightLegIn
    lowLeftLegIn > (highRightLegIn - 0.00005)


// f_fvg_legin_dbd(float lowLeftLegIn, float highRightLegIn) =>
//     lowLeftLegIn > highRightLegIn or (highRightLegIn - lowLeftLegIn) <= 0.1

// =====================================================================
// FVG LEG OUT DBD
// =====================================================================
// Acuan utama : Candle 3
//
// Candle 3 = [0]
//
// Candle kiri  = [1]       → ambil LOW
// Candle kanan = [future]  → ambil HIGH
//
// FVG bearish valid apabila:
// LOW candle kiri > HIGH candle kanan
//
// Return:
// true  = FVG Leg Out valid
// false = FVG Leg Out tidak valid
//
// CATATAN:
// Candle kanan C3 adalah candle future, sehingga fungsi ini
// baru bisa dievaluasi setelah candle berikutnya terbentuk.
// =====================================================================

f_fvg_legout_dbd(float lowLeftLegOut, float highRightLegOut) =>
    // lowLeftLegOut > highRightLegOut 
    lowLeftLegOut > (highRightLegOut - 0.00005) 

// f_fvg_legout_dbd(float lowLeftLegOut, float highRightLegOut) =>
//     lowLeftLegOut > highRightLegOut or (highRightLegOut - lowLeftLegOut) <= 0.1

// fungsi dbd tipe 1 Single, ini sempurna
f_dbd_tipe_1(okLegIn, okLegOut, okCandle2, okFvgLegIn, okFvgLegOut, dropOK) =>
    okLegIn and okLegOut and okCandle2 and okFvgLegIn and okFvgLegOut and dropOK

// fungsi dbd tipe 2 Single , hanya FVG Leg In yang valid
f_dbd_tipe_2(okLegIn, okLegOut, okCandle2, okFvgLegIn, dropOK) =>
    okLegIn and okLegOut and okCandle2 and okFvgLegIn and dropOK

// fungsi dbd tipe 3 Single , hanya FVG Leg Out yang valid
f_dbd_tipe_3(okLegIn, okLegOut, okCandle2, okFvgLegOut, dropOK) =>
    okLegIn and okLegOut and okCandle2 and okFvgLegOut and dropOK

// Kode error 8: body leg out >= total ekor leg out
// false berarti ekor leg out lebih panjang daripada body
f_legOutBodyOk(float o, float h, float l, float c) =>
    f_convertPip(f_body(o, c)) >= f_convertPip(f_totalWick(o, h, l, c))

// candle leg out valid: drop, body vs ekor (sesuai sensitifitas), dan posisi
// MANDATORY: close leg out < close leg in DAN open leg out < open leg in
// cek body >= AVG sudah dipindah ke f_bodyAvgOk (error code 6)
f_legOut_valid(float o, float h, float l, float c, float openLegIn, float closeLegIn, float toleransi_persen, string mode, int offset) =>
    bool posisiOk = c < closeLegIn and o < openLegIn

    if mode == 'dbd' and inputSensitifitas == 'HIGH'
        f_isDrop(o, c) and f_body(o, c) > f_totalWick(o, h, l, c) and posisiOk

    else if mode == 'dbd' and inputSensitifitas == 'MEDIUM'
        f_isDrop(o, c) and f_body(o, c) >= f_totalWick(o, h, l, c) and posisiOk

    else if mode == 'dbd' and inputSensitifitas == 'LOW'
        f_isDrop(o, c) and posisiOk     // syarat body vs ekor dipindah ke error code 8

    else
        false


// Return: [n base, skor]  (skor: 3=AAA, 2=AA, 1=A, 99=NO FVG, 0=tidak valid)
// Return: [n base, jumlah error, kode error]
// n base = 0 berarti pola tidak ditemukan
f_dbd_multiple(int minBase, int maxBase, float pct, bool needDrop) =>
    int    nFound   = 0
    int    errCount = 0
    string errCodes = ""

    bool dropOut = not needDrop or f_isDrop(open[1], close[1])

    if dropOut
        bool okFvgOut = f_fvg_legout_dbd(low[2], high[0])

        for n = minBase to maxBase
            int k = n + 2

            bool okLegOut = f_legOut_valid(
                 open[1], high[1], low[1], close[1],
                 open[k], close[k],
                 inputToleransiAvg, 'dbd', 1)

            bool okLegIn = f_legIn_valid(
                 open[k], high[k], low[k], close[k],
                 inputToleransiAvg, 'dbd', k)
            bool dropIn = not needDrop or f_isDrop(open[k], close[k])

            // if okLegOut and okLegIn and dropIn and f_baseMultiple(n, pct)
            if okLegOut and okLegIn and dropIn and f_baseMultiple(n, pct) and f_baseBodyOk(n) and (devMode or f_jarakBaseOk(n, 0.5))
                bool okFvgIn  = f_fvg_legin_dbd(low[k + 1], high[n + 1])
                bool jarakOk  = f_jarakBaseOk(n, 0.5)
                bool tanpaFvg = not okFvgIn and not okFvgOut

                // sensitifitas selain LOW tetap wajib punya minimal 1 FVG
                if not tanpaFvg or inputSensitifitas == 'LOW'
                    nFound := n

                    if tanpaFvg
                        errCount += 1
                        errCodes += "3 "
                    else
                        if not okFvgIn
                            errCount += 1
                            errCodes += "1 "
                        if not okFvgOut
                            errCount += 1
                            errCodes += "2 "

                    if not jarakOk
                        errCount += 1
                        errCodes += "4 "

                    if not f_bodyAvgOk(open[k], close[k], k)
                        errCount += 1
                        errCodes += "5 "

                    if not f_bodyAvgOk(open[1], close[1], 1)
                        errCount += 1
                        errCodes += "6 "

                    if not f_legInBodyOk(open[k], high[k], low[k], close[k])
                        errCount += 1
                        errCodes += "7 "

                    if not f_legOutBodyOk(open[1], high[1], low[1], close[1])
                        errCount += 1
                        errCodes += "8 "

                    if not f_baseAtasOk(n)
                        errCount += 1
                        errCodes += "9 "

                    if not f_baseBawahOk(n)
                        errCount += 1
                        errCodes += "10 "

                    break

    [nFound, errCount, str.trim(errCodes)]

// Deskripsi tiap kode error
f_errDesc(string code) =>
    switch code
        "1"  => "FVG Leg In tidak valid"
        "2"  => "FVG Leg Out tidak valid"
        "3"  => "Tanpa FVG"
        "4"  => "Jarak base > 50% body leg in/out"
        "5"  => "Body leg in < AVG body"
        "6"  => "Body leg out < AVG body"
        "7"  => "Ekor leg in > body leg in"
        "8"  => "Ekor leg out > body leg out"
        "9"  => "Ekor atas base menembus open leg in"
        "10" => "Ekor bawah base turun di bawah low leg out"
        => "Kode tidak dikenal"

// Label hanya huruf grade (A, B, C, ...)
f_gradeText(int errCount, string errCodes) =>
    int idx = math.min(errCount, 25)
    str.substring("ABCDEFGHIJKLMNOPQRSTUVWXYZ", idx, idx + 1)

// Isi tooltip: grade + daftar error beserta penjelasannya
f_gradeTip(int errCount, string errCodes) =>
    string g = f_gradeText(errCount, errCodes)
    string t = "Grade " + g
    if errCount == 0
        t += "\nTidak ada error"
    else
        array<string> codes = str.split(errCodes, " ")
        for k = 0 to codes.size() - 1
            string c = codes.get(k)
            if c != ""
                t += "\n[" + c + "] " + f_errDesc(c)
    t



// =====================================================================
// FUNGSI POLA DBD SINGLE
// =====================================================================
// Return: [valid, jumlah error, kode error]
f_dbd_single(
     float o1, float h1, float l1, float c1,
     float o2, float h2, float l2, float c2,
     float o3, float h3, float l3, float c3,
     float lowLeftFvgLegIn,
     float highRightFvgLegIn,
     float lowLeftFvgLegOut,
     float highRightFvgLegOut,
     bool needDrop,
     float wickPctIn) =>

    bool okLegIn = f_legIn_valid(o1, h1, l1, c1, inputToleransiAvg, 'dbd', 3)
    // bool okCandle2 = f_wickVsBody(o2, h2, l2, c2, wickPctIn, 2)
    bool okCandle2 = f_wickVsBodySingle(o2, h2, l2, c2, wickPctIn, 2)
    bool okLegOut = f_legOut_valid(o3, h3, l3, c3, o1, c1, inputToleransiAvg, 'dbd', 1)

    bool okFvgLegIn  = f_fvg_legin_dbd(lowLeftFvgLegIn, highRightFvgLegIn)
    bool okFvgLegOut = f_fvg_legout_dbd(lowLeftFvgLegOut, highRightFvgLegOut)

    bool dropOK = not needDrop or (f_isDrop(o1, c1) and f_isDrop(o3, c3))

    // jarak base: base = 1 candle (C2), dihitung relatif ke bar saat ini
    bool jarakOk = f_jarakBaseOk(1, 0.5)

    bool baseBodyOk = f_baseBodyOk(1)
    bool polaOk   = okLegIn and okLegOut and okCandle2 and dropOK and baseBodyOk and (devMode or jarakOk)
    bool tanpaFvg = not okFvgLegIn and not okFvgLegOut

    // selain LOW, wajib punya minimal 1 FVG (sama seperti aturan lama)
    bool valid = polaOk and (not tanpaFvg or inputSensitifitas == 'LOW')

    int    errCount = 0
    string errCodes = ""

    if valid
        if tanpaFvg
            errCount += 1
            errCodes += "3 "
        else
            if not okFvgLegIn
                errCount += 1
                errCodes += "1 "
            if not okFvgLegOut
                errCount += 1
                errCodes += "2 "

        if not jarakOk
            errCount += 1
            errCodes += "4 "

        if not f_bodyAvgOk(o1, c1, 3)
            errCount += 1
            errCodes += "5 "

        if not f_bodyAvgOk(o3, c3, 1)
            errCount += 1
            errCodes += "6 "

        if not f_legInBodyOk(o1, h1, l1, c1)
            errCount += 1
            errCodes += "7 "

        if not f_legOutBodyOk(o3, h3, l3, c3)
            errCount += 1
            errCodes += "8 "

        if h2 > o1
            errCount += 1
            errCodes += "9 "

        if l2 < c3
            errCount += 1
            errCodes += "10 "

    [valid, errCount, str.trim(errCodes)]

// ---------- FVG bullish ----------
// Leg In : high candle kiri [4] < low candle kanan [2] (base)
f_fvg_legin_rbr(float highLeftLegIn, float lowRightLegIn) =>
    highLeftLegIn < (lowRightLegIn + 0.00005)

// Leg Out: high candle kiri [2] (base) < low candle kanan [0]
f_fvg_legout_rbr(float highLeftLegOut, float lowRightLegOut) =>
    highLeftLegOut < (lowRightLegOut + 0.00005)

// ---------- Leg In RBR: bullish ----------
f_legIn_valid_rbr(float o, float h, float l, float c) =>
    if inputSensitifitas == 'HIGH'
        f_isBullish(o, c) and f_body(o, c) > f_totalWick(o, h, l, c)
    else if inputSensitifitas == 'MEDIUM'
        f_isBullish(o, c) and f_body(o, c) >= f_totalWick(o, h, l, c)
    else
        f_isBullish(o, c)      // syarat body vs ekor ada di error code 7

// ---------- Leg Out RBR: bullish, posisi MANDATORY ----------
// close leg out > close leg in DAN open leg out > open leg in
f_legOut_valid_rbr(float o, float h, float l, float c, float openLegIn, float closeLegIn) =>
    bool posisiOk = c > closeLegIn and o > openLegIn
    if inputSensitifitas == 'HIGH'
        f_isBullish(o, c) and f_body(o, c) > f_totalWick(o, h, l, c) and posisiOk
    else if inputSensitifitas == 'MEDIUM'
        f_isBullish(o, c) and f_body(o, c) >= f_totalWick(o, h, l, c) and posisiOk
    else
        f_isBullish(o, c) and posisiOk

// ---------- Candle base RBR (cermin f_wickVsBodySingle) ----------
// candle bearish dengan body > ekor dianggap OK (kebalikan dari DBD)
f_wickVsBodySingleRbr(float o, float h, float l, float c, float pct, int offset) =>
    f_convertPip(f_body(o, c)) < f_convertPip(f_avgBodyInPrice(limitCandleAvg, 'dbd', offset)) or
     f_convertPip(f_totalWick(o, h, l, c)) >= f_convertPip(f_body(o, c)) or
     (f_isDrop(o, c) and f_convertPip(f_body(o, c)) > f_convertPip(f_totalWick(o, h, l, c)))

// ---------- Pola RBR Single ----------
// Return: [valid, jumlah error, kode error]
f_rbr_single(
     float o1, float h1, float l1, float c1,
     float o2, float h2, float l2, float c2,
     float o3, float h3, float l3, float c3,
     float highLeftFvgLegIn,  float lowRightFvgLegIn,
     float highLeftFvgLegOut, float lowRightFvgLegOut,
     bool needRally,
     float wickPctIn) =>

    bool okLegIn   = f_legIn_valid_rbr(o1, h1, l1, c1)
    bool okCandle2 = f_wickVsBodySingleRbr(o2, h2, l2, c2, wickPctIn, 2)
    bool okLegOut  = f_legOut_valid_rbr(o3, h3, l3, c3, o1, c1)

    bool okFvgLegIn  = f_fvg_legin_rbr(highLeftFvgLegIn, lowRightFvgLegIn)
    bool okFvgLegOut = f_fvg_legout_rbr(highLeftFvgLegOut, lowRightFvgLegOut)

    bool rallyOK = not needRally or (f_isBullish(o1, c1) and f_isBullish(o3, c3))
    bool jarakOk = f_jarakBaseOk(1, 0.5)

    bool baseBodyOk = f_baseBodyOk(1)
    bool polaOk   = okLegIn and okLegOut and okCandle2 and rallyOK and baseBodyOk and (devMode or jarakOk)
    bool tanpaFvg = not okFvgLegIn and not okFvgLegOut
    bool valid    = polaOk and (not tanpaFvg or inputSensitifitas == 'LOW')

    int    errCount = 0
    string errCodes = ""

    if valid
        if tanpaFvg
            errCount += 1
            errCodes += "3 "
        else
            if not okFvgLegIn
                errCount += 1
                errCodes += "1 "
            if not okFvgLegOut
                errCount += 1
                errCodes += "2 "

        if not jarakOk
            errCount += 1
            errCodes += "4 "

        if not f_bodyAvgOk(o1, c1, 3)
            errCount += 1
            errCodes += "5 "

        if not f_bodyAvgOk(o3, c3, 1)
            errCount += 1
            errCodes += "6 "

        if not f_legInBodyOk(o1, h1, l1, c1)
            errCount += 1
            errCodes += "7 "

        if not f_legOutBodyOk(o3, h3, l3, c3)
            errCount += 1
            errCodes += "8 "

        if l2 < l1          // ekor bawah base menembus open leg in (cermin kode 9)
            errCount += 1
            errCodes += "9 "

        if h2 > h3          // ekor atas base melewati close leg out (cermin kode 10)
            errCount += 1
            errCodes += "10 "

    [valid, errCount, str.trim(errCodes)]

// ---------- Tooltip RBR (deskripsi kode 9 & 10 berbeda) ----------
f_errDescRbr(string code) =>
    switch code
        "1"  => "FVG Leg In tidak valid"
        "2"  => "FVG Leg Out tidak valid"
        "3"  => "Tanpa FVG"
        "4"  => "Jarak base > 50% body leg in/out"
        "5"  => "Body leg in < AVG body"
        "6"  => "Body leg out < AVG body"
        "7"  => "Ekor leg in > body leg in"
        "8"  => "Ekor leg out > body leg out"
        "9"  => "Ekor bawah base menembus ekor bawah leg in"
        "10" => "Ekor atas base melewati ekor atas leg out"
        => "Kode tidak dikenal"

f_gradeTipRbr(int errCount, string errCodes) =>
    string t = "RBR Grade " + f_gradeText(errCount, errCodes)
    if errCount == 0
        t += "\nTidak ada error"
    else
        array<string> codes = str.split(errCodes, " ")
        for k = 0 to codes.size() - 1
            string c = codes.get(k)
            if c != ""
                t += "\n[" + c + "] " + f_errDescRbr(c)
    t

var array<int>    zLeft      = array.new<int>()
var array<int>    zRight     = array.new<int>()
var array<float>  zTop       = array.new<float>()   // ekor tertinggi base
var array<float>  zBot       = array.new<float>()   // ekor terendah base
var array<int>    zStart     = array.new<int>()     // scan ke kanan mulai dari bar ini
