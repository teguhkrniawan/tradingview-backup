     wickPct)

validRbr := validRbr and errRbr <= str.pos("ABCDEFGHIJK", inputMinGrade)

markRbr = validRbr and barstate.isconfirmed and showRbrSingle

// non-backtest: langsung gambar
if markRbr and not backtestMode
    box.new(
         left = bar_index - 3, top = high[2],
         right = bar_index - 1, bottom = low[2],
         border_color = color.green, border_width = 1,
         bgcolor = color.new(color.green, 85))
    if showArrow
        label.new(
             bar_index - 2, low[2],
             f_gradeText(errRbr, errCodeRbr),
             style     = label.style_label_up,
             color     = color.green,
             textcolor = color.black,
             size      = size.tiny,
             tooltip   = f_gradeTipRbr(errRbr, errCodeRbr))

// backtest: simpan zona
if markRbr and backtestMode
    rLeft.push(bar_index - 3)
    rRight.push(bar_index - 1)
    rTop.push(high[2])
    rBot.push(low[2])
    rStart.push(bar_index)
    rLblX.push(bar_index - 2)
    rText.push(f_gradeText(errRbr, errCodeRbr))
    rTip.push(f_gradeTipRbr(errRbr, errCodeRbr))
    rIsMulti.push(false)
    rbrBaseZone.set(bar_index - 2, rTop.size() - 1)

[nRbrMulti, errRbrM, errCodeRbrM] = f_rbr_multiple(MIN_BASE_T5, MAX_BASE_T5, wickPct, reqDrop)

if errRbrM > str.pos("ABCDEFGHIJK", inputMinGrade)   // <-- TARUH DI SINI
    nRbrMulti := 0

markRbrMulti = nRbrMulti != 0 and barstate.isconfirmed and showRbrMultiple

// non-backtest: langsung gambar
if markRbrMulti and not backtestMode
    box.new(
         left = bar_index - (nRbrMulti + 1), top = f_baseTop(nRbrMulti),
         right = bar_index - 2,              bottom = f_baseBottom(nRbrMulti),
         border_color = color.teal, border_width = 1,
         bgcolor = color.new(color.teal, 85))
    if showArrow
        label.new(
             bar_index - 2, f_baseBottom(nRbrMulti),
             f_gradeText(errRbrM, errCodeRbrM),
             style     = label.style_label_up,
             color     = color.teal,
             textcolor = color.white,
             size      = size.tiny,
             tooltip   = f_gradeTipRbr(errRbrM, errCodeRbrM))

// backtest: simpan zona
if markRbrMulti and backtestMode
    rLeft.push(bar_index - (nRbrMulti + 1))
    rRight.push(bar_index - 2)
    rTop.push(f_baseTop(nRbrMulti))
    rBot.push(f_baseBottom(nRbrMulti))
    rStart.push(bar_index)
    rLblX.push(bar_index - 2)
    rText.push(f_gradeText(errRbrM, errCodeRbrM))
    rTip.push(f_gradeTipRbr(errRbrM, errCodeRbrM))
    rIsMulti.push(true)

    for d = 2 to nRbrMulti + 1
        rbrBaseZone.set(bar_index - d, rTop.size() - 1)

if barstate.isconfirmed and bar_index >= 10
    if validRbr
        for d = 1 to 3
            rbrPat.set(bar_index - d, 1)
        rbrBaseFlag.set(bar_index - 2, 1)
    if nRbrMulti != 0
        for d = 1 to nRbrMulti + 2
            rbrPat.set(bar_index - d, 1)
        for d = 2 to nRbrMulti + 1
            rbrBaseFlag.set(bar_index - d, 1)

[nBaseMulti, errMulti, errCodeMulti] = f_dbd_multiple(MIN_BASE_T5, MAX_BASE_T5, wickPct, reqDrop)

if errMulti > str.pos("ABCDEFGHIJK", inputMinGrade)   // <-- TARUH DI SINI
    nBaseMulti := 0

// Penanda candle yang menjadi bagian pola DBD (leg in / base / leg out)
// Tidak tergantung toggle showDbdSingle / showDbdMultiple
var array<int> patFlag = array.new<int>()
while patFlag.size() <= bar_index
    patFlag.push(0)

if barstate.isconfirmed and bar_index >= 10
    if validSingle
        for d = 1 to 3                       // C3=[1], C2=[2], C1=[3]
            patFlag.set(bar_index - d, 1)
    if nBaseMulti != 0
        for d = 1 to nBaseMulti + 2          // leg out=[1], base=[2..n+1], leg in=[n+2]
            patFlag.set(bar_index - d, 1)

var array<int> baseFlag = array.new<int>()
var array<int> baseZone = array.new<int>()
while baseFlag.size() <= bar_index
    baseFlag.push(0)
    baseZone.push(-1)

if barstate.isconfirmed and bar_index >= 10
    if validSingle
        baseFlag.set(bar_index - 2, 1)
    if nBaseMulti != 0
        for d = 2 to nBaseMulti + 1
            baseFlag.set(bar_index - d, 1)

markMulti = nBaseMulti != 0 and barstate.isconfirmed and showArrow and showDbdMultiple

// 0 error = A, 1 = B, 2 = C, 3 = D, dst (maksimal sampai H)
string gradeMulti = str.substring("ABCDEFGH", math.min(errMulti, 7), math.min(errMulti, 7) + 1)


string txtMulti = nBaseMulti == 0 ? "" : f_gradeText(errMulti, errCodeMulti)
// ---- simpan zona Single ----
if backtestMode and markRectangleBase
    zLeft.push(bar_index - 3)
    zRight.push(bar_index - 1)
    zTop.push(high[2])
    zBot.push(low[2])
    zStart.push(bar_index)
    zLblX.push(bar_index - 2)
    zText.push(f_gradeText(errSingle, errCodeSingle))
    zTip.push(f_gradeTip(errSingle, errCodeSingle))
    zIsSingle.push(true)
    zShowLbl.push(showArrow)
    zShowBox.push(showDbdSingle)
    baseZone.set(bar_index - 2, zTop.size() - 1)

// ---- simpan zona Multiple ----
if backtestMode and nBaseMulti != 0 and barstate.isconfirmed and showDbdMultiple
    zLeft.push(bar_index - (nBaseMulti + 1))
    zRight.push(bar_index - 2)
    zTop.push(f_baseTop(nBaseMulti))
    zBot.push(f_baseBottom(nBaseMulti))
    zStart.push(bar_index)
    zLblX.push(bar_index - 2)
    zText.push(txtMulti)
    zTip.push(f_gradeTip(errMulti, errCodeMulti))
    zIsSingle.push(false)
    zShowLbl.push(showArrow)
    zShowBox.push(showDbdMultiple)
    for d = 2 to nBaseMulti + 1
        baseZone.set(bar_index - d, zTop.size() - 1)

if markMulti and not backtestMode
    box.new(
         left   = bar_index - (nBaseMulti + 1),
         top    = f_baseTop(nBaseMulti),
         right  = bar_index - 2,
         bottom = f_baseBottom(nBaseMulti),
         border_color = color.orange,
         border_width = 1,
         bgcolor = color.new(color.orange, 85))

    label.new(
         bar_index - 2,
         f_baseTop(nBaseMulti),
        //  "M" + str.tostring(nBaseMulti) + ": " + txtMulti,
         txtMulti,
         style     = label.style_label_down,
         color     = color.orange,
         textcolor = color.black,
         size      = size.tiny,
         tooltip   = f_gradeTip(errMulti, errCodeMulti))

// =====================================================================
// KOTAK CANDLE 2
// =====================================================================
if markRectangleBase and not backtestMode
    box.new(
         left = bar_index - 3,
         top = high[2],
         right = bar_index - 1,
         bottom = low[2],
         border_color = color.blue,
         border_width = 1,
         bgcolor = color.new(color.blue, 85))


var array<label> debugLabels = array.new<label>()

if barstate.islast
    // bersihkan label lama
    while debugLabels.size() > 0
        label.delete(debugLabels.pop())

    // hanya render kalau toggle aktif
    if showDebugLegin
        for i = 0 to jmlLabel - 1
            int off = geserKiri + i          // offset dari bar terakhir
            if off > bar_index
                break

            float o = open[off]
            float h = high[off]
            float l = low[off]
            float c = close[off]

            float candleRange = h - l
            float bodyInPip   = f_convertPip(f_body(o, c))
            float avgInPip    = f_convertPip(f_avgBodyInPrice(limitCandleAvg, 'dbd', off))
            float ekorInPip   = f_convertPip(f_totalWick(o, h, l, c))

            debugLabels.push(label.new(
                 x = bar_index - off,
                 y = l - candleRange * 0.7,
                 text = str.tostring(bodyInPip) + "\n" + str.tostring(avgInPip) + "\n" + str.tostring(ekorInPip),
                 yloc = yloc.price,
                 style = label.style_none,
                 textcolor = color.yellow,
                 size = size.normal))

// SWING KODE

// =====================================================================
// SWING HIGH / SWING LOW PER BLOK (berbasis BODY, bukan ekor)
// Swing High = puncak body tertinggi
//   bearish -> open | bullish -> close  (= max(open, close))
// Swing Low  = dasar body terendah
//   bearish -> close | bullish -> open  (= min(open, close))
// startOff = offset awal blok (0 = bar terakhir)
// size     = jumlah candle dalam blok
// Return: [harga high, offset high, harga low, offset low]
// =====================================================================
f_swingBlock(int startOff, int size) =>
    float hi    = f_isDrop(open[startOff], close[startOff]) ? open[startOff]  : close[startOff]
    int   hiOff = startOff
    float lo    = f_isDrop(open[startOff], close[startOff]) ? close[startOff] : open[startOff]
    int   loOff = startOff

    for i = startOff to startOff + size - 1
        bool  drop    = f_isDrop(open[i], close[i])
        float topBody = drop ? open[i]  : close[i]   // bearish: open, bullish: close
        float botBody = drop ? close[i] : open[i]    // bearish: close, bullish: open

        if topBody > hi
            hi    := topBody
            hiOff := i
        if botBody < lo
            lo    := botBody
            loOff := i

    [hi, hiOff, lo, loOff]


f_validSH(array<float> topA, array<float> botA, int pIdx, int toIdx) =>
    int   cnt = 0
    float ref = botA.get(pIdx)          // body bawah candle puncak
    if pIdx < toIdx
        for j = pIdx + 1 to toIdx
            if topA.get(j) < ref        // body atas candle di kanan
                cnt += 1
                if cnt >= 2
                    break
    cnt >= 2

f_validSL(array<float> topA, array<float> botA, array<float> clsA, int pIdx, int toIdx) =>
    int   cnt = 0
    float ref = clsA.get(pIdx)          // close candle lembah
    if pIdx < toIdx
        for j = pIdx + 1 to toIdx
            if botA.get(j) > ref        // body bawah (min open/close) > close lembah
                cnt += 1
                if cnt >= 2
                    break
    cnt >= 2

// =====================================================================
// ZIGZAG SWING (berbasis BODY, seluruh candle yang ter-load)
// Body puncak/dasar tiap bar disimpan di array -> tanpa batas lookback
// =====================================================================
// =====================================================================
// ZIGZAG SWING (berbasis BODY, seluruh candle yang ter-load)
// =====================================================================
var array<float> topArr  = array.new<float>()   // puncak body
var array<float> botArr  = array.new<float>()   // dasar body
var array<float> hiArr   = array.new<float>()   // puncak ekor (high)
var array<float> loArr   = array.new<float>()   // dasar ekor (low)
var array<float> shArr   = array.new<float>()   // harga untuk Swing High
var array<float> slArr   = array.new<float>()   // harga untuk Swing Low
var array<int>   timeArr = array.new<int>()
var array<label> swingLabels = array.new<label>()
var array<line>  zzLines     = array.new<line>()
var line lastSHLine = na
var label lastSHLabel = na
var line  lastSLLine  = na
var label lastSLLabel = na



// true = zona INVALID: ekor atas base (levelAtas) sudah tertabrak
// oleh body candle mana pun di kanan. Selama belum tertabrak, zona tetap valid.
// levelBawah tidak dipakai lagi, tetap ada di parameter supaya pemanggil tidak perlu diubah.
f_zonaInvalid(float levelAtas, float levelBawah, int startIdx) =>
    bool kenaHigh = false
    int  endIdx   = barstate.isconfirmed ? bar_index : bar_index - 1
    for i = startIdx to endIdx
        float bTop = topArr.get(i)
        float bBot = botArr.get(i)

        if levelAtas >= bBot and levelAtas <= bTop
            kenaHigh := true
            break
    kenaHigh

// true = zona RBR INVALID: ekor bawah base (levelBawah) tertabrak body di kanan
f_zonaInvalidRbr(float levelBawah, int startIdx) =>
    bool kena   = false
    int  endIdx = barstate.isconfirmed ? bar_index : bar_index - 1
    for i = startIdx to endIdx
        if levelBawah >= botArr.get(i) and levelBawah <= topArr.get(i)
            kena := true
            break
    kena

// true = candle i adalah base yang boleh ditabrak garis pink
// Backtest Mode aktif: zona base itu juga harus belum tersentuh harga
f_baseAktif(int i) =>
    bool ok = false
    if i >= 0 and i < baseFlag.size()
        if baseFlag.get(i) == 1
            if not backtestMode
                ok := true
            else
                int zid = baseZone.get(i)
                if zid >= 0 and zid < zTop.size()
                    // ok := not f_zonaInvalid(zTop.get(zid), zBot.get(zid), zStart.get(zid))
                    ok := not zDead.get(zid)
    ok

// Ekor tertinggi dari seluruh candle base pada DBD yang sama
// Prioritas: pakai zTop (sudah berisi high tertinggi base, Single maupun Multiple)
// Fallback (non-backtest, zona tidak disimpan): telusuri candle base yang berdempetan
f_baseTopAt(int i) =>
    float t   = hiArr.get(i)
    int   zid = baseZone.get(i)

    if zid >= 0 and zid < zTop.size()
        t := zTop.get(zid)
    else
        int j = i - 1
        while j >= 0 and baseFlag.get(j) == 1
            t := math.max(t, hiArr.get(j))
            j -= 1

        j := i + 1
        while j < hiArr.size() and baseFlag.get(j) == 1
            t := math.max(t, hiArr.get(j))
            j += 1
    t

// true = candle i adalah base RBR yang masih aktif
f_baseAktifRbr(int i) =>
    bool ok = false
    if i >= 0 and i < rbrBaseFlag.size()
        if rbrBaseFlag.get(i) == 1
            if not backtestMode
                ok := true
            else
                int zid = rbrBaseZone.get(i)
                if zid >= 0 and zid < rTop.size()
                    // ok := not f_zonaInvalidRbr(rBot.get(zid), rStart.get(zid))
                    ok := not rDead.get(zid)
    ok

// Ekor terbawah dari seluruh candle base pada RBR yang sama
f_baseBottomAt(int i) =>
    float b   = loArr.get(i)
    int   zid = rbrBaseZone.get(i)

    if zid >= 0 and zid < rBot.size()
        b := rBot.get(zid)
    else
        int j = i - 1
        while j >= 0 and rbrBaseFlag.get(j) == 1
            b := math.min(b, loArr.get(j))
            j -= 1

        j := i + 1
        while j < loArr.size() and rbrBaseFlag.get(j) == 1
            b := math.min(b, loArr.get(j))
            j += 1
    b

while topArr.size() <= bar_index
    topArr.push(0.0)
    botArr.push(0.0)
    hiArr.push(0.0)
    loArr.push(0.0)
    shArr.push(0.0)
    slArr.push(0.0)
    timeArr.push(0)
    clsArr.push(0.0)

topArr.set(bar_index, math.max(open, close))
botArr.set(bar_index, math.min(open, close))
hiArr.set(bar_index, high)
loArr.set(bar_index, low)
shArr.set(bar_index, swingBasis == "Body" ? math.max(open, close) : high)
slArr.set(bar_index, swingBasis == "Body" ? math.min(open, close) : low)
timeArr.set(bar_index, time)
clsArr.set(bar_index, close)

// daftarkan zona baru
while zDead.size() < zTop.size()
    zActive.push(zDead.size())
    zDead.push(false)
while rDead.size() < rTop.size()
    rActive.push(rDead.size())
    rDead.push(false)

float curTop = math.max(open, close)
float curBot = math.min(open, close)

// DBD: ekor atas base tertabrak body bar ini?
if zActive.size() > 0
    for a = zActive.size() - 1 to 0
        int z = zActive.get(a)
        float lvl = zTop.get(z)
        if lvl >= curBot and lvl <= curTop
            zDead.set(z, true)
            zActive.remove(a)

// RBR: ekor bawah base tertabrak body bar ini?
if rActive.size() > 0
    for a = rActive.size() - 1 to 0
        int z = rActive.get(a)
        float lvl = rBot.get(z)
        if lvl >= curBot and lvl <= curTop
            rDead.set(z, true)
            rActive.remove(a)

// gambar ulang hanya saat data historis selesai dimuat, lalu sekali di awal tiap bar baru
bool doDraw = barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isnew)
// if barstate.islast and backtestMode
if doDraw and backtestMode
    while zoneBoxes.size() > 0
        box.delete(zoneBoxes.pop())
    while zoneLabels.size() > 0
        label.delete(zoneLabels.pop())

    // dari terbaru ke lama, berhenti di 450 supaya aman dari limit 500
    if zTop.size() > 0
        for z = zTop.size() - 1 to 0
            if zoneBoxes.size() >= 450
                break

            if not f_zonaInvalid(zTop.get(z), zBot.get(z), zStart.get(z))
                bool  isSingle = zIsSingle.get(z)
                color col      = isSingle ? color.blue : color.orange

                if zShowBox.get(z)
                    zoneBoxes.push(box.new(
                         left = timeArr.get(zLeft.get(z)), top = zTop.get(z),
                         right = timeArr.get(zRight.get(z)), bottom = zBot.get(z),
                         xloc = xloc.bar_time,
                         border_color = col, border_width = 1,
                         bgcolor = color.new(col, 85)))

                if zShowLbl.get(z)
                    zoneLabels.push(label.new(
                         x = timeArr.get(zLblX.get(z)), y = zTop.get(z),
                         xloc = xloc.bar_time,
                         text = zText.get(z),
                         style = label.style_label_down,
                         color = isSingle ? markerColor : color.orange,
                         textcolor = color.black,
                         size = size.tiny,
                         tooltip = zTip.get(z)))

if doDraw and backtestMode
    while rBoxes.size() > 0
        box.delete(rBoxes.pop())
    while rLabels.size() > 0
        label.delete(rLabels.pop())

    if rTop.size() > 0
        for z = rTop.size() - 1 to 0
            if rBoxes.size() >= 100
                break
            if not f_zonaInvalidRbr(rBot.get(z), rStart.get(z))
                bool  isMulti = rIsMulti.get(z)
                color col     = isMulti ? color.teal : color.green

                rBoxes.push(box.new(
                     left = timeArr.get(rLeft.get(z)), top = rTop.get(z),
                     right = timeArr.get(rRight.get(z)), bottom = rBot.get(z),
                     xloc = xloc.bar_time,
                     border_color = col, border_width = 1,
                     bgcolor = color.new(col, 85)))
                if showArrow
                    rLabels.push(label.new(
                         x = timeArr.get(rLblX.get(z)), y = rBot.get(z),
                         xloc = xloc.bar_time,
                         text = rText.get(z),
                         style = label.style_label_up,
                         color = col,
                         textcolor = isMulti ? color.white : color.black,
                         size = size.tiny,
                         tooltip = rTip.get(z)))

if barstate.islast
    while swingLabels.size() > 0
        label.delete(swingLabels.pop())
    while zzLines.size() > 0
        line.delete(zzLines.pop())

    if not na(lastSHLine)
        line.delete(lastSHLine)
        lastSHLine := na

    if not na(lastSHLabel)
        label.delete(lastSHLabel)
        lastSHLabel := na

    if not na(lastSHLine)
        line.delete(lastSHLine)
        lastSHLine := na

    if not na(lastSHLabel)
        label.delete(lastSHLabel)
        lastSHLabel := na

    if not na(fibTopBox)
        box.delete(fibTopBox)
        fibTopBox := na
    if not na(fibBotBox)
        box.delete(fibBotBox)
        fibBotBox := na
    if not na(tpLine)
        line.delete(tpLine)
        tpLine := na
    if not na(tpLabel)
        label.delete(tpLabel)
        tpLabel := na

    if showSwing and bar_index >= 1
        
        array<float> swP   = array.new_float()
        array<int>   swIdx = array.new_int()
        array<int>   swT   = array.new_int() 

        // mulai dari bar pertama, leg awal = naik
        int   dir    = 1
        float extP   = shArr.get(0)
        int   extIdx = 0
        float oppP   = slArr.get(0)
        int   oppIdx = 0

        for idx = 1 to bar_index
            float topB = shArr.get(idx)
            float botB = slArr.get(idx)

            if dir == 1
                if topB > extP
                    extP   := topB
                    extIdx := idx
                    oppP   := botB
                    oppIdx := idx
                else
                    if botB < oppP
                        oppP   := botB
                        oppIdx := idx
                    if oppIdx - extIdx >= swingMinBars and f_validSH(topArr, botArr, extIdx, idx)
                        swP.push(extP)
                        swIdx.push(extIdx)
                        swT.push(1)
                        dir    := -1
                        extP   := oppP
                        extIdx := oppIdx
                        oppP   := shArr.get(extIdx)
                        oppIdx := extIdx
                        for j = extIdx to idx
                            if shArr.get(j) > oppP
                                oppP   := shArr.get(j)
                                oppIdx := j
            else
                if botB < extP
                    extP   := botB
                    extIdx := idx
                    oppP   := topB
                    oppIdx := idx
                else
                    if topB > oppP
                        oppP   := topB
                        oppIdx := idx
                    if oppIdx - extIdx >= swingMinBars and f_validSL(topArr, botArr, clsArr, extIdx, idx)
                        swP.push(extP)
                        swIdx.push(extIdx)
                        swT.push(-1)
                        dir    := 1
                        extP   := oppP
                        extIdx := oppIdx
                        oppP   := slArr.get(extIdx)
                        oppIdx := extIdx
                        for j = extIdx to idx
                            if slArr.get(j) < oppP
                                oppP   := slArr.get(j)
                                oppIdx := j
            

        // swing terakhir (leg yang masih berjalan)
        // puncak yang belum valid (belum ada 2 candle konfirmasi) tidak digambar
        bool lastValid = dir == 1 ? f_validSH(topArr, botArr, extIdx, bar_index) : f_validSL(topArr, botArr, clsArr, extIdx, bar_index)

        if lastValid
            swP.push(extP)
            swIdx.push(extIdx)
            swT.push(dir)

        // cari swing high terakhir (dari belakang)
        int   lastSHIdx   = na
        float lastSHPrice = na
        for k = swP.size() - 1 to 0
            if swT.get(k) == 1
                lastSHIdx   := swIdx.get(k)
                lastSHPrice := swP.get(k)
                break

        // harga garis pink: telusuri ke kiri dari SH terakhir
        // valid kalau harga menabrak candle BASE dari DBD (ekor bawah / body / ekor atas)
        // harga akhir = high (ekor atas) candle base yang ketabrak
        float pinkPrice = lastSHPrice
        bool  pinkValid = false
        int   hitIdx    = na
        int   curRefIdx = lastSHIdx
        float curRefPriceP = lastSHPrice
        bool  stopP     = false
        bool  viaLegIn  = false
        int   legInIdx  = na
        array<string> skipList = array.new_string()   // riwayat puncak acuan

        if not na(lastSHIdx) and lastSHIdx > 0
            int i = lastSHIdx - 1
            while i >= 0
                // range ekor (low..high) sudah mencakup body
                if pinkPrice >= loArr.get(i) and pinkPrice <= hiArr.get(i)

                    // leg in DBD = bagian pola, bukan base, dan candle kanannya adalah base
                    bool isLegIn  = patFlag.get(i) == 1 and baseFlag.get(i) == 0 and i + 1 < baseFlag.size() and baseFlag.get(i + 1) == 1
                    // candle tepat di kiri leg in adalah base DBD yang masih aktif
                    bool kiriBase = i >= 1 and f_baseAktif(i - 1)

                    // leg out DBD = bagian pola, bukan base, dan candle kirinya adalah base
                    bool isLegOutP = patFlag.get(i) == 1 and baseFlag.get(i) == 0 and i >= 1 and baseFlag.get(i - 1) == 1
                    // cari candle base aktif di area leg out ini yang disentuh garis (ekor atau body)
                    int baseHitP = na
                    if isLegOutP
                        int jbP = i - 1
                        while jbP >= 0 and baseFlag.get(jbP) == 1
                            if f_baseAktif(jbP) and pinkPrice >= loArr.get(jbP) and pinkPrice <= hiArr.get(jbP)
                                baseHitP := jbP
                                break
                            jbP -= 1

                    if f_baseAktif(i)
                        // skenario 1: kena base DBD aktif
                        pinkPrice := f_baseTopAt(i)
                        pinkValid := true
                        hitIdx    := i
                        break
                    else if isLegIn and kiriBase
                        // skenario 2: kena leg in DBD, dan candle di kirinya adalah base
                        pinkPrice := f_baseTopAt(i - 1)
                        pinkValid := true
                        hitIdx    := i - 1
                        viaLegIn  := true
                        legInIdx  := i
                        break
                    else if isLegOutP and not na(baseHitP)
                        // skenario 3: kena leg out DBD, dan garis juga menyentuh base di area ini
                        pinkPrice := f_baseTopAt(baseHitP)
                        pinkValid := true
                        hitIdx    := baseHitP
                        break
                    else
                        // alasan singkat kenapa puncak ini dilewati
                        string alasanP = ""
                        if baseFlag.get(i) == 1
                            alasanP := "kena base DBD yang sudah mati"
                        else if isLegIn
                            alasanP := "kena leg in DBD, tapi candle kirinya bukan base aktif"
                        else if patFlag.get(i) == 1
                            alasanP := "kena leg out DBD, bukan base"
                        else
                            alasanP := "kena candle biasa, bukan base"

                        string wktHitP = str.format_time(timeArr.get(i), "dd/MM HH:mm", "GMT+7")
                        string wktRefP = str.format_time(timeArr.get(curRefIdx), "dd/MM HH:mm", "GMT+7")

                        // cari gunung terdekat di kiri puncak acuan saat ini yang LEBIH TINGGI
                        int   nextIdx   = na
                        float nextPrice = na
                        for k = swP.size() - 1 to 0
                            if swT.get(k) == 1 and swIdx.get(k) < curRefIdx and swP.get(k) > pinkPrice
                                nextIdx   := swIdx.get(k)
                                nextPrice := swP.get(k)
                                break

                        if na(nextIdx)
                            skipList.push(wktRefP + " @ " + str.tostring(curRefPriceP, format.mintick) +
                                 " -> SKIP: " + alasanP + " (" + wktHitP + "), tidak ada puncak lebih tinggi, berhenti")
                            stopP := true
                            break

                        skipList.push(wktRefP + " @ " + str.tostring(curRefPriceP, format.mintick) +
                             " -> SKIP: " + alasanP + " (" + wktHitP + ")")

                        curRefIdx    := nextIdx
                        curRefPriceP := nextPrice
                        pinkPrice    := nextPrice
                        i            := nextIdx - 1
                        continue
                i -= 1

            // catat puncak acuan terakhir (yang akhirnya dipakai)
            string wktRefAkhirP = str.format_time(timeArr.get(curRefIdx), "dd/MM HH:mm", "GMT+7")
            if pinkValid
                if viaLegIn
                    skipList.push(wktRefAkhirP + " @ " + str.tostring(curRefPriceP, format.mintick) +
                         " -> DIPAKAI: kena leg in DBD (" + str.format_time(timeArr.get(legInIdx), "dd/MM HH:mm", "GMT+7") +
                         "), base di kirinya (" + str.format_time(timeArr.get(hitIdx), "dd/MM HH:mm", "GMT+7") + ")")
                else
                    skipList.push(wktRefAkhirP + " @ " + str.tostring(curRefPriceP, format.mintick) +
                         " -> DIPAKAI: kena base DBD (" + str.format_time(timeArr.get(hitIdx), "dd/MM HH:mm", "GMT+7") + ")")
            else if not stopP
                skipList.push(wktRefAkhirP + " @ " + str.tostring(curRefPriceP, format.mintick) +
                     " -> tidak kena candle apa pun di kiri")

        if showLastSH and not na(lastSHIdx)
            int pinkX1 = pinkValid and not na(hitIdx) ? timeArr.get(hitIdx) : timeArr.get(lastSHIdx)

            lastSHLine := line.new(
                 x1 = pinkX1,                 y1 = pinkPrice,
                 x2 = time,                   y2 = pinkPrice,
                 xloc   = xloc.bar_time,
                 extend = extend.right,
                 color  = lastSHLineCol,
                 style  = pinkValid ? line.style_solid : line.style_dashed,
                 width  = 2)

            string waktuDbd = pinkValid and not na(hitIdx) ?
                 "\nDBD: " + str.format_time(timeArr.get(hitIdx), "dd/MM HH:mm", "GMT+7") :
                 "\nDBD: tidak ditemukan"

            string txtSkip = ""
            int    nSkip   = skipList.size()
            if nSkip > 0
                txtSkip := "\nPuncak acuan (" + str.tostring(nSkip) + "):"
                for s = 0 to math.min(nSkip, 8) - 1
                    txtSkip += "\n" + str.tostring(s + 1) + ". " + skipList.get(s)
                if nSkip > 8
                    txtSkip += "\n+" + str.tostring(nSkip - 8) + " lainnya"
            else
                txtSkip := "\nPuncak acuan: tidak ada"

            // label di kanan bar terakhir (area kosong), di atas garis pink
            int geserKananP = (time - time[1]) * 3

            lastSHLabel := label.new(
                 x         = time + geserKananP,
                 y         = pinkPrice,
                 xloc      = xloc.bar_time,
                 text      = "Garis Control - " + str.tostring(pinkPrice, format.mintick) + waktuDbd + txtSkip,
                 style     = label.style_label_lower_left,
                 color     = color.new(color.black, 20),
                 textcolor = lastSHLineCol,
                 textalign = text.align_left,
                 size      = size.small)  

        // ===== GARIS CONTROL RBR (hijau) =====
        int   lastSLIdx   = na
        float lastSLPrice = na
        for k = swP.size() - 1 to 0
            if swT.get(k) == -1
                lastSLIdx   := swIdx.get(k)
                lastSLPrice := swP.get(k)
                break

        // GARIS SWING LOW
        float greenPrice = lastSLPrice
        bool  greenValid = false
        int   hitIdxG    = na
        int   curRefIdxG = lastSLIdx
        float curRefPriceG = lastSLPrice
        bool  stopG      = false
        bool  viaLegInG  = false
        int   legInIdxG  = na
        array<string> skipListG = array.new_string()   // riwayat lembah acuan

        if not na(lastSLIdx) and lastSLIdx > 0
            int i = lastSLIdx - 1
            while i >= 0
                // range ekor (low..high) sudah mencakup body
                if greenPrice >= loArr.get(i) and greenPrice <= hiArr.get(i)

                    // leg in RBR = bagian pola, bukan base, dan candle kanannya adalah base
                    bool isLegInG  = rbrPat.get(i) == 1 and rbrBaseFlag.get(i) == 0 and i + 1 < rbrBaseFlag.size() and rbrBaseFlag.get(i + 1) == 1
                    // candle tepat di kiri leg in adalah base RBR yang masih aktif
                    bool kiriBaseG = i >= 1 and f_baseAktifRbr(i - 1)

                    // leg out RBR = bagian pola, bukan base, dan candle kirinya adalah base
                    bool isLegOutG = rbrPat.get(i) == 1 and rbrBaseFlag.get(i) == 0 and i >= 1 and rbrBaseFlag.get(i - 1) == 1
                    // cari candle base aktif di area leg out ini yang disentuh garis (ekor atau body)
                    int baseHitG = na
                    if isLegOutG
                        int jb = i - 1
                        while jb >= 0 and rbrBaseFlag.get(jb) == 1
                            if f_baseAktifRbr(jb) and greenPrice >= loArr.get(jb) and greenPrice <= hiArr.get(jb)
                                baseHitG := jb
                                break
                            jb -= 1

                    if f_baseAktifRbr(i)
                        // skenario 1: kena base RBR aktif
                        greenPrice := f_baseBottomAt(i)
                        greenValid := true
                        hitIdxG    := i
                        break
                    else if isLegInG and kiriBaseG
                        // skenario 2: kena leg in RBR, dan candle di kirinya adalah base
                        greenPrice := f_baseBottomAt(i - 1)
                        greenValid := true
                        hitIdxG    := i - 1
                        viaLegInG  := true
                        legInIdxG  := i
                        break
                    else if isLegOutG and not na(baseHitG)
                        // skenario 3: kena leg out RBR, dan garis juga menyentuh base di area ini
                        greenPrice := f_baseBottomAt(baseHitG)
                        greenValid := true
                        hitIdxG    := baseHitG
                        break
                    else
                        // alasan singkat kenapa lembah ini dilewati
                        string alasan = ""
                        if rbrBaseFlag.get(i) == 1
                            alasan := "kena base RBR yang sudah mati"
                        else if isLegInG
                            alasan := "kena leg in RBR, tapi candle kirinya bukan base aktif"
                        else if rbrPat.get(i) == 1
                            alasan := "kena leg out RBR, bukan base"
                        else
                            alasan := "kena candle biasa, bukan base"

                        string wktHit = str.format_time(timeArr.get(i), "dd/MM HH:mm", "GMT+7")
                        string wktRef = str.format_time(timeArr.get(curRefIdxG), "dd/MM HH:mm", "GMT+7")

                        // cari lembah terdekat di kiri lembah acuan saat ini yang LEBIH RENDAH
                        int   nextIdx   = na
                        float nextPrice = na
                        for k = swP.size() - 1 to 0
                            if swT.get(k) == -1 and swIdx.get(k) < curRefIdxG and swP.get(k) < greenPrice
                                nextIdx   := swIdx.get(k)
                                nextPrice := swP.get(k)
                                break

                        if na(nextIdx)
                            skipListG.push(wktRef + " @ " + str.tostring(curRefPriceG, format.mintick) +
                                 " -> SKIP: " + alasan + " (" + wktHit + "), tidak ada lembah lebih rendah, berhenti")
                            stopG := true
                            break

                        skipListG.push(wktRef + " @ " + str.tostring(curRefPriceG, format.mintick) +
                             " -> SKIP: " + alasan + " (" + wktHit + ")")

                        curRefIdxG   := nextIdx
                        curRefPriceG := nextPrice
                        greenPrice   := nextPrice
                        i            := nextIdx - 1
                        continue
                i -= 1

            // catat lembah acuan terakhir (yang akhirnya dipakai)
            string wktRefAkhir = str.format_time(timeArr.get(curRefIdxG), "dd/MM HH:mm", "GMT+7")
            if greenValid
                if viaLegInG
                    skipListG.push(wktRefAkhir + " @ " + str.tostring(curRefPriceG, format.mintick) +
                         " -> DIPAKAI: kena leg in RBR (" + str.format_time(timeArr.get(legInIdxG), "dd/MM HH:mm", "GMT+7") +
                         "), base di kirinya (" + str.format_time(timeArr.get(hitIdxG), "dd/MM HH:mm", "GMT+7") + ")")
                else
                    skipListG.push(wktRefAkhir + " @ " + str.tostring(curRefPriceG, format.mintick) +
                         " -> DIPAKAI: kena base RBR (" + str.format_time(timeArr.get(hitIdxG), "dd/MM HH:mm", "GMT+7") + ")")
            else if not stopG
                skipListG.push(wktRefAkhir + " @ " + str.tostring(curRefPriceG, format.mintick) +
                     " -> tidak kena candle apa pun di kiri")

        if showLastSL and not na(lastSLIdx)
            int greenX1 = greenValid and not na(hitIdxG) ? timeArr.get(hitIdxG) : timeArr.get(lastSLIdx)

            lastSLLine := line.new(
                 x1 = greenX1,                y1 = greenPrice,
                 x2 = time,                   y2 = greenPrice,
                 xloc   = xloc.bar_time,
                 extend = extend.right,
                 color  = lastSLLineCol,
                 style  = greenValid ? line.style_solid : line.style_dashed,
                 width  = 2)

            string waktuRbr = greenValid and not na(hitIdxG) ?
                 "\nRBR: " + str.format_time(timeArr.get(hitIdxG), "dd/MM HH:mm", "GMT+7") :
                 "\nRBR: tidak ditemukan"

            string txtSkipG = ""
            int    nSkipG   = skipListG.size()
            if nSkipG > 0
                txtSkipG := "\nLembah acuan (" + str.tostring(nSkipG) + "):"
                for s = 0 to math.min(nSkipG, 8) - 1
                    txtSkipG += "\n" + str.tostring(s + 1) + ". " + skipListG.get(s)
                if nSkipG > 8
                    txtSkipG += "\n+" + str.tostring(nSkipG - 8) + " lainnya"
            else
                txtSkipG := "\nLembah acuan: tidak ada"

            // label di kanan bar terakhir (area kosong), di bawah garis hijau
            int geserKananG = (time - time[1]) * 3

            lastSLLabel := label.new(
                 x         = time + geserKananG,
                 y         = greenPrice,
                 xloc      = xloc.bar_time,
                 text      = "Garis Control RBR - " + str.tostring(greenPrice, format.mintick) + waktuRbr + txtSkipG,
                 style     = label.style_label_upper_left,
                 color     = color.new(color.black, 20),
                 textcolor = lastSLLineCol,
                 textalign = text.align_left,
                 size      = size.small)     

        if showLastSL and not na(lastSLIdx)
            int greenX1 = greenValid and not na(hitIdxG) ? timeArr.get(hitIdxG) : timeArr.get(lastSLIdx)

            lastSLLine := line.new(
                 x1 = greenX1,                y1 = greenPrice,
                 x2 = time,                   y2 = greenPrice,
                 xloc   = xloc.bar_time,
                 extend = extend.right,
                 color  = lastSLLineCol,
                 style  = greenValid ? line.style_solid : line.style_dashed,
                 width  = 2)

           
        
        // ===== FIBONACCI 25% + TP =====
        if not na(lastSHIdx) and not na(lastSLIdx) and pinkPrice > greenPrice
            int pinkLeft  = pinkValid  and not na(hitIdx)  ? timeArr.get(hitIdx)  : timeArr.get(lastSHIdx)
            int greenLeft = greenValid and not na(hitIdxG) ? timeArr.get(hitIdxG) : timeArr.get(lastSLIdx)
            int fibLeft   = math.max(pinkLeft, greenLeft)

            float rentang  = pinkPrice - greenPrice
            float topBatas = pinkPrice  - rentang * 0.25
            float botBatas = greenPrice + rentang * 0.25
            float tpPrice  = (pinkPrice + greenPrice) / 2.0

            // zona 25% dari garis pink ke bawah
            fibTopBox := box.new(
                 left = fibLeft, top = pinkPrice,
                 right = time,   bottom = topBatas,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = color.new(fibTopCol, 100),
                 bgcolor = color.new(fibTopCol, 80))

            // zona 25% dari garis hijau ke atas
            fibBotBox := box.new(
                 left = fibLeft, top = botBatas,
                 right = time,   bottom = greenPrice,
                 xloc = xloc.bar_time,
                 extend = extend.right,
                 border_color = color.new(fibBotCol, 100),
                 bgcolor = color.new(fibBotCol, 80))

            // garis TP di tengah (50%)
            tpLine := line.new(
                 x1 = fibLeft, y1 = tpPrice,
                 x2 = time,    y2 = tpPrice,
                 xloc   = xloc.bar_time,
                 extend = extend.right,
                 color  = color.gray,
                 width  = 2)

            tpLabel := label.new(
                 x = fibLeft, y = tpPrice,
                 xloc = xloc.bar_time,
                 text = "TP - " + str.tostring(tpPrice, format.mintick),
                 style = label.style_label_down,
                 color = color.new(color.gray, 100),
                 textcolor = color.gray,
                 size = size.small)

        // gambar garis + label (pakai waktu, bukan bar_index)
        for k = 0 to swP.size() - 1
            bool  isHigh = swT.get(k) == 1
            int   x      = timeArr.get(swIdx.get(k))
            float y      = swP.get(k)

            if k > 0
                zzLines.push(line.new(
                     x1 = timeArr.get(swIdx.get(k - 1)), y1 = swP.get(k - 1),
                     x2 = x, y2 = y,
                     xloc = xloc.bar_time,
                     color = zzLineCol, width = 1))

            // swingLabels.push(label.new(
            //      x = x,
            //      y = y,
            //      xloc = xloc.bar_time,
            //      text = (isHigh ? "SH " : "SL ") + str.tostring(y, format.mintick),
            //      style = isHigh ? label.style_label_down : label.style_label_up,
            //      color = isHigh ? swingHighCol : swingLowCol,
            //      textcolor = isHigh ? color.white : color.black,
            //      size = size.tiny))