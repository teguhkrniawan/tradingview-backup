//     found

// candle leg out yang valid, apabila body lebih besar daripada ekor
// DAN close leg out < open leg in
// Leg out valid: drop, body >= ekor & >= avg body,
// close < open leg in, dan close < close leg in
f_legOut_valid(float o, float h, float l, float c, float openLegIn, float closeLegIn, float toleransi_persen, string mode, int offset) =>
    // syarat tambahan: close leg out di bawah open leg in dan close leg in
    bool closeDiBawahOpenLegIn  = c < openLegIn
    bool closeDiBawahCloseLegIn = c < closeLegIn
    bool posisiOk = closeDiBawahOpenLegIn and closeDiBawahCloseLegIn

    if mode == 'dbd' and inputSensitifitas == 'HIGH'
        is_drop_candle = f_isDrop(o, c)
        avg_body = f_avgBodyInPrice(limitCandleAvg, mode, offset)
        body = f_body(o, c)
        nilai_body_allowed = avg_body
        // HIGH: body harus > ekor
        is_drop_candle and body >= nilai_body_allowed and body > f_totalWick(o, h, l, c) and posisiOk

    else if mode == 'dbd' and inputSensitifitas == 'MEDIUM'

        is_drop_candle = f_isDrop(o, c)
        body = f_body(o, c)
        avg_body = f_avgBodyInPrice(limitCandleAvg, mode, offset)
        nilai_body_allowed = avg_body

        // MEDIUM: body >= ekor
        is_drop_candle and body >= f_totalWick(o, h, l, c) and body >= nilai_body_allowed and posisiOk

    else if mode == 'dbd' and inputSensitifitas == 'LOW'

        is_drop_candle = f_isDrop(o, c)
        body = f_body(o, c)

        avg_body = f_avgBodyInPrice(limitCandleAvg, mode, offset)
        nilai_body_allowed = avg_body

        total_ekor = f_totalWick(o, h, l, c)
        // LOW: perbandingan dalam pip
        is_drop_candle and f_convertPip(body) >= f_convertPip(total_ekor) and f_convertPip(body) >= f_convertPip(nilai_body_allowed) and posisiOk

    else
        false

// Return: [n base, skor]  (skor: 3=AAA, 2=AA, 1=A, 99=NO FVG, 0=tidak valid)
// Return: [n base, jumlah error, kode error]
// n base = 0 berarti pola tidak ditemukan
f_dbd_multiple(int minBase, int maxBase, float pct, bool needDrop) =>
    int    nFound   = 0
    int    errCount = 0
    string errCodes = ""

    bool dropOut = not needDrop or f_isDrop(open[1], close[1])

    if dropOut
        bool okFvgOut = f_fvg_legout_dbd(low[2], high[0])

        for n = minBase to maxBase
            int k = n + 2

            bool okLegOut = f_legOut_valid(
                 open[1], high[1], low[1], close[1],
                 open[k], close[k],
                 inputToleransiAvg, 'dbd', 1)

            bool okLegIn = f_legIn_valid(
                 open[k], high[k], low[k], close[k],
                 inputToleransiAvg, 'dbd', k)
            bool dropIn = not needDrop or f_isDrop(open[k], close[k])

            if okLegOut and okLegIn and dropIn and f_baseMultiple(n, pct)
                bool okFvgIn  = f_fvg_legin_dbd(low[k + 1], high[n + 1])
                bool jarakOk  = f_jarakBaseOk(n, 0.5)
                bool tanpaFvg = not okFvgIn and not okFvgOut

                // sensitifitas selain LOW tetap wajib punya minimal 1 FVG
                if not tanpaFvg or inputSensitifitas == 'LOW'
                    nFound := n

                    if tanpaFvg
                        errCount += 1
                        errCodes += "3 "
                    else
                        if not okFvgIn
                            errCount += 1
                            errCodes += "1 "
                        if not okFvgOut
                            errCount += 1
                            errCodes += "2 "

                    if not jarakOk
                        errCount += 1
                        errCodes += "4 "

                    break

    [nFound, errCount, str.trim(errCodes)]

// 0 error = A, 1 = B, 2 = C, dst (maksimal H)
f_gradeText(int errCount, string errCodes) =>
    int idx = math.min(errCount, 7)
    string g = str.substring("ABCDEFGH", idx, idx + 1)
    g + (errCount > 0 ? " [" + str.replace_all(errCodes, " ", ",") + "]" : "")

// =====================================================================
// FUNGSI POLA DBD SINGLE
// =====================================================================
// Return: [valid, jumlah error, kode error]
f_dbd_single(
     float o1, float h1, float l1, float c1,
     float o2, float h2, float l2, float c2,
     float o3, float h3, float l3, float c3,
     float lowLeftFvgLegIn,
     float highRightFvgLegIn,
     float lowLeftFvgLegOut,
     float highRightFvgLegOut,
     bool needDrop,
     float wickPctIn) =>

    bool okLegIn = f_legIn_valid(o1, h1, l1, c1, inputToleransiAvg, 'dbd', 3)
    // bool okCandle2 = f_wickVsBody(o2, h2, l2, c2, wickPctIn, 2)
    bool okCandle2 = f_wickVsBodySingle(o2, h2, l2, c2, wickPctIn, 2, o1, c3)
    bool okLegOut = f_legOut_valid(o3, h3, l3, c3, o1, c1, inputToleransiAvg, 'dbd', 1)

    bool okFvgLegIn  = f_fvg_legin_dbd(lowLeftFvgLegIn, highRightFvgLegIn)
    bool okFvgLegOut = f_fvg_legout_dbd(lowLeftFvgLegOut, highRightFvgLegOut)

    bool dropOK = not needDrop or (f_isDrop(o1, c1) and f_isDrop(o3, c3))

    // jarak base: base = 1 candle (C2), dihitung relatif ke bar saat ini
    bool jarakOk = f_jarakBaseOk(1, 0.5)

    bool polaOk   = okLegIn and okLegOut and okCandle2 and dropOK
    bool tanpaFvg = not okFvgLegIn and not okFvgLegOut

    // selain LOW, wajib punya minimal 1 FVG (sama seperti aturan lama)
    bool valid = polaOk and (not tanpaFvg or inputSensitifitas == 'LOW')

    int    errCount = 0
    string errCodes = ""

    if valid
        if tanpaFvg
            errCount += 1
            errCodes += "3 "
        else
            if not okFvgLegIn
                errCount += 1
                errCodes += "1 "
            if not okFvgLegOut
                errCount += 1
                errCodes += "2 "

        if not jarakOk
            errCount += 1
            errCodes += "4 "

    [valid, errCount, str.trim(errCodes)]

    // ================================================================
    // HITUNG SCORE
    // ================================================================

    // int score = 0

    // if inputSensitifitas == 'HIGH' or inputSensitifitas == 'MEDIUM'
