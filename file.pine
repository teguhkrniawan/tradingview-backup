        //     score += 3

       

        // // section kalau gak ada FVG
        // else if okLegIn and okLegOut and okCandle2 and dropOK 
        //     score += 99
       

    // ================================================================
    // CETAK SCORE
    // ================================================================

    // string skor =
    //      score == 3 ? "AAA" :
    //      score == 2 ? "AA" :
    //      score == 1 ? "A" :
    //      score == 4 ? "AAA" :
    //      score == 99 ? "NO FVG" :
    //      "F"

    // skor
    // score



// skorDbdSingle = f_dbd_single(
//      open[3], high[3], low[3], close[3],     // C1
//      open[2], high[2], low[2], close[2],     // C2
