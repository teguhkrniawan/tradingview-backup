//@version=5
// indicator("Indicator Versi Teguh", overlay=true)
// indicator("Indicator Versi Teguh", overlay=true, max_labels_count=500, max_bars_back=200)
indicator("Indicator Versi Teguh", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=200)

// =====================================================================
//  INPUT
// =====================================================================
// Candle 1 & 3: body minimal X% dari total ekor (atas + bawah)
//   100 = body sama dengan total ekor, di atas 100 = body makin dominan
// group cabdle 1
// bodyPct = input.float(60.0, "C1 & C3: body minimal (% dari total ekor)", minval=0.0, step=1.0, group="Candle 1 & 3")
inputToleransiAvg = input.float(100.0, "Toleransi Body AVG (brp % dari AVG Body)", minval=0.0, step=1.0, group="Candle 1 & 3")

// Candle 2: total ekor minimal Y% dari body
//   100 = ekor sama dengan body, di bawah 100 = ekor boleh lebih pendek dari body
// Group Candle 2
// wickPct = input.float(30.0, "C2: ekor minimal (% dari body)", minval=0.0, step=1.0, group="Candle 2")
wickPct = 50

reqDrop = input.bool(true, "Candle 1 & 3 Drop", group="Candle 1 & 3")

// Group Penanda
markerColor = input.color(color.yellow, "Warna panah & teks", group="Penanda")
showArrow = input.bool(true, "Tampilkan Panah", group="Penanda")

// group AVG Body
limitCandleAvg = input.int(100,"Berapa jumlah candle stick utk AVG Body (terhitung dri candle) ?",minval=1,step=1,group="Avg Body")

inputSensitifitas = input.string(
     "LOW",
     "Pilih Sensitifitas",
     options = ["LOW", "MEDIUM", "HIGH"],
     group = "Sensitifitas")

showDebugLegin = input.bool(false, "DEBUG", group="Debug")
// showDebugLegout = input.bool(false, "DEBUG LEG OUT", group="Debug")
// showDebugBase = input.bool(false, "DEBUG BASE", group="Debug")

jmlLabel       = input.int(100, "Jumlah label debug", minval=1, maxval=400, group="Debug")
geserKiri      = input.int(0, "Geser ke kiri (jumlah bar)", minval=0, group="Debug")

// group Swing
showSwing     = input.bool(true, "Tampilkan Zigzag Swing", group="Swing")
// swingLookback = input.int(200, "Lookback (jumlah candle)", minval=20, group="Swing")
swingMinBars  = input.int(75, "Jarak minimal antar swing (candle)", minval=1, group="Swing")
swingHighCol  = input.color(color.red, "Warna Swing High", group="Swing")
swingLowCol   = input.color(color.lime, "Warna Swing Low", group="Swing")
zzLineCol     = input.color(color.white, "Warna garis zigzag", group="Swing")
showLastSH   = input.bool(true, "Garis horizontal Swing High terakhir", group="Swing")
lastSHLineCol = input.color(color.rgb(255, 105, 180), "Warna garis SH terakhir (pink)", group="Swing")

showDbdSingle   = input.bool(false, "Tampilkan DBD Single", group="Penanda")
showDbdMultiple = input.bool(false, "Tampilkan DBD Multiple", group="Penanda")

if inputSensitifitas == "MEDIUM"
    wickPct := 60

if inputSensitifitas == "HIGH"
    wickPct := 70
// =====================================================================
//  FUNGSI DASAR (bisa dipakai ulang di indikator lain)
//  Parameter: o = open, h = high, l = low, c = close
// =====================================================================

// Konstanta Candle base
MIN_BASE_T5 = 2
MAX_BASE_T5 = 6



// Ukuran body candle
f_body(float o, float c) =>
    math.abs(c - o)

// Panjang ekor atas
f_upperWick(float o, float h, float c) =>
    h - math.max(o, c)

// Panjang ekor bawah
f_lowerWick(float o, float l, float c) =>
    math.min(o, c) - l

// Total ekor (atas + bawah)
f_totalWick(float o, float h, float l, float c) =>
    f_upperWick(o, h, c) + f_lowerWick(o, l, c)

// Candle drop / bearish
f_isDrop(float o, float c) =>
    c <= o

// Candle naik / bullish
f_isBullish(float o, float c) =>
    c >= o

f_convertPip(float angka) =>
    float hasil = 0.0

    if str.contains(syminfo.ticker, "JPY")
        hasil := math.round(angka * 100)
    else if str.contains(syminfo.ticker, "XAU")
        hasil := math.round(angka * 1)
    else
        hasil := math.round(angka * 10000)

    hasil

// Body minimal pct% dari total ekor
//   Contoh pct = 60 -> body >= 60% x total ekor
f_bodyVsWick(float o, float h, float l, float c, float pct) =>
    f_body(o, c) >= f_totalWick(o, h, l, c) * 1


// f_avgBodyInPrice(int limitCandle, string mode, int offset) =>
//     float totalBody = 0.0
//     if mode == 'dbd'
//         for i = 1 + offset to limitCandle + offset
//             totalBody += math.abs(close[i] - open[i])
//     totalBody / limitCandle

// Rata-rata body, hanya dari candle yang body-nya > total ekor
// Window tetap limitCandle candle (mulai dari [1 + offset])
f_avgBodyInPrice(int limitCandle, string mode, int offset) =>
    float totalBody = 0.0
    int   count     = 0

    if mode == 'dbd'
        for i = 1 + offset to limitCandle + offset
            float body = math.abs(close[i] - open[i])
            float ekor = f_totalWick(open[i], high[i], low[i], close[i])

            // seleksi: hanya candle dengan body lebih besar dari ekor
            if body > ekor
                totalBody += body
                count += 1

    count > 0 ? totalBody / count : 0.0

f_wickVsBody(float o, float h, float l, float c, float pct, offset) =>

    body = f_body(o, c)

    if f_convertPip(f_body(o, c)) < f_convertPip(f_avgBodyInPrice(limitCandleAvg, 'dbd', offset))
        true
    else if f_convertPip(f_totalWick(o, h, l, c) ) >= f_convertPip(f_body(o, c))
        true
    else if f_isBullish(o, c) and f_convertPip(f_body(o,c)) >  f_convertPip(f_totalWick(o, h, l, c))
        true
    else
        false

f_wickVsBodySingle(float o, float h, float l, float c, float pct, int offset, float openLegIn, float closeLegOut) =>

    bool bodyWickOk =
         f_convertPip(f_body(o, c)) < f_convertPip(f_avgBodyInPrice(limitCandleAvg, 'dbd', offset)) or
         f_convertPip(f_totalWick(o, h, l, c)) >= f_convertPip(f_body(o, c)) or
         (f_isBullish(o, c) and f_convertPip(f_body(o, c)) > f_convertPip(f_totalWick(o, h, l, c)))

    bool atasOk  = h <= openLegIn     // ekor atas tidak boleh melebihi open leg in
    bool bawahOk = l >= closeLegOut   // ekor bawah tidak boleh di bawah close leg out

    bodyWickOk and atasOk and bawahOk

