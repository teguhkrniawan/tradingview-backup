var array<string> zText      = array.new<string>()
var array<string> zTip       = array.new<string>()
var array<bool>   zIsSingle  = array.new<bool>()
var array<bool>   zShowLbl   = array.new<bool>()
var array<bool>   zShowBox   = array.new<bool>()
