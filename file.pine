[validSingle, errSingle, errCodeSingle] = f_dbd_single(
     open[3], high[3], low[3], close[3],     // C1
     open[2], high[2], low[2], close[2],     // C2
     open[1], high[1], low[1], close[1],     // C3
     low[4],  high[2],                       // FVG Leg In
     low[2],  high[0],                       // FVG Leg Out
     reqDrop,
     wickPct)

markSingle        = validSingle and barstate.isconfirmed and showArrow and showDbdSingle
markRectangleBase = validSingle and barstate.isconfirmed and showDbdSingle

if markSingle
    label.new(
         bar_index - 2,
         high[2],
         f_gradeText(errSingle, errCodeSingle),
         style     = label.style_label_down,
         color     = markerColor,
         textcolor = color.black,
         size      = size.tiny)

[nBaseMulti, errMulti, errCodeMulti] = f_dbd_multiple(MIN_BASE_T5, MAX_BASE_T5, wickPct, reqDrop)

// Penanda candle yang menjadi bagian pola DBD (leg in / base / leg out)
// Tidak tergantung toggle showDbdSingle / showDbdMultiple
var array<int> patFlag = array.new<int>()
while patFlag.size() <= bar_index
    patFlag.push(0)

if barstate.isconfirmed and bar_index >= 10
    if validSingle
        for d = 1 to 3                       // C3=[1], C2=[2], C1=[3]
            patFlag.set(bar_index - d, 1)
    if nBaseMulti != 0
        for d = 1 to nBaseMulti + 2          // leg out=[1], base=[2..n+1], leg in=[n+2]
            patFlag.set(bar_index - d, 1)

markMulti = nBaseMulti != 0 and barstate.isconfirmed and showArrow and showDbdMultiple

// 0 error = A, 1 = B, 2 = C, 3 = D, dst (maksimal sampai H)
string gradeMulti = str.substring("ABCDEFGH", math.min(errMulti, 7), math.min(errMulti, 7) + 1)

string txtMulti = nBaseMulti == 0 ? "" :
     gradeMulti + (errMulti > 0 ? " [" + str.replace_all(errCodeMulti, " ", ",") + "]" : "")

if markMulti
    box.new(
         left   = bar_index - (nBaseMulti + 1),
         top    = f_baseTop(nBaseMulti),
         right  = bar_index - 2,
         bottom = f_baseBottom(nBaseMulti),
         border_color = color.orange,
         border_width = 1,
         bgcolor = color.new(color.orange, 85))

    label.new(
         bar_index - 2,
         f_baseTop(nBaseMulti),
        //  "M" + str.tostring(nBaseMulti) + ": " + txtMulti,
         txtMulti,
         style     = label.style_label_down,
         color     = color.orange,
         textcolor = color.black,
         size      = size.tiny)


// =====================================================================
// KOTAK CANDLE 2
// =====================================================================
if markRectangleBase
    box.new(
         left = bar_index - 3,
         top = high[2],
         right = bar_index - 1,
         bottom = low[2],
         border_color = color.blue,
         border_width = 1,
         bgcolor = color.new(color.blue, 85))


var array<label> debugLabels = array.new<label>()

if barstate.islast
    // bersihkan label lama
    while debugLabels.size() > 0
        label.delete(debugLabels.pop())

    // hanya render kalau toggle aktif
    if showDebugLegin
        for i = 0 to jmlLabel - 1
            int off = geserKiri + i          // offset dari bar terakhir
            if off > bar_index
                break

            float o = open[off]
            float h = high[off]
            float l = low[off]
            float c = close[off]

            float candleRange = h - l
            float bodyInPip   = f_convertPip(f_body(o, c))
            float avgInPip    = f_convertPip(f_avgBodyInPrice(limitCandleAvg, 'dbd', off))
            float ekorInPip   = f_convertPip(f_totalWick(o, h, l, c))

            debugLabels.push(label.new(
                 x = bar_index - off,
                 y = l - candleRange * 0.7,
                 text = str.tostring(bodyInPip) + "\n" + str.tostring(avgInPip) + "\n" + str.tostring(ekorInPip),
                 yloc = yloc.price,
                 style = label.style_none,
                 textcolor = color.yellow,
                 size = size.normal))

// SWING KODE

// =====================================================================
// SWING HIGH / SWING LOW PER BLOK (berbasis BODY, bukan ekor)
// Swing High = puncak body tertinggi
//   bearish -> open | bullish -> close  (= max(open, close))
// Swing Low  = dasar body terendah
//   bearish -> close | bullish -> open  (= min(open, close))
// startOff = offset awal blok (0 = bar terakhir)
// size     = jumlah candle dalam blok
// Return: [harga high, offset high, harga low, offset low]
// =====================================================================
f_swingBlock(int startOff, int size) =>
    float hi    = f_isDrop(open[startOff], close[startOff]) ? open[startOff]  : close[startOff]
    int   hiOff = startOff
    float lo    = f_isDrop(open[startOff], close[startOff]) ? close[startOff] : open[startOff]
    int   loOff = startOff

    for i = startOff to startOff + size - 1
        bool  drop    = f_isDrop(open[i], close[i])
        float topBody = drop ? open[i]  : close[i]   // bearish: open, bullish: close
        float botBody = drop ? close[i] : open[i]    // bearish: close, bullish: open

        if topBody > hi
            hi    := topBody
            hiOff := i
        if botBody < lo
            lo    := botBody
            loOff := i

    [hi, hiOff, lo, loOff]


// Swing High valid: >= 2 candle di kanan dengan body ATAS < body BAWAH candle puncak
f_validSH(array<float> topA, array<float> botA, int pIdx, int toIdx) =>
    int   cnt = 0
    float ref = botA.get(pIdx)          // body bawah candle puncak
    for j = pIdx + 1 to toIdx
        if topA.get(j) < ref            // body atas candle di kanan
            cnt += 1
            if cnt >= 2
                break
    cnt >= 2

// Swing Low valid: >= 2 candle di kanan dengan body BAWAH > body ATAS candle lembah
f_validSL(array<float> topA, array<float> botA, int pIdx, int toIdx) =>
    int   cnt = 0
    float ref = topA.get(pIdx)          // body atas candle lembah
    for j = pIdx + 1 to toIdx
        if botA.get(j) > ref            // body bawah candle di kanan
            cnt += 1
            if cnt >= 2
                break
    cnt >= 2

// =====================================================================
// ZIGZAG SWING (berbasis BODY, seluruh candle yang ter-load)
// Body puncak/dasar tiap bar disimpan di array -> tanpa batas lookback
// =====================================================================
// =====================================================================
// ZIGZAG SWING (berbasis BODY, seluruh candle yang ter-load)
// =====================================================================
var array<float> topArr  = array.new<float>()
var array<float> botArr  = array.new<float>()
var array<int>   timeArr = array.new<int>()
var array<label> swingLabels = array.new<label>()
var array<line>  zzLines     = array.new<line>()
var line lastSHLine = na

topArr.push(math.max(open, close))
botArr.push(math.min(open, close))
timeArr.push(time)

if barstate.islast
    while swingLabels.size() > 0
        label.delete(swingLabels.pop())
    while zzLines.size() > 0
        line.delete(zzLines.pop())

    if not na(lastSHLine)
        line.delete(lastSHLine)
        lastSHLine := na

    if showSwing and bar_index >= 1
        array<float> swP   = array.new<float>()
        array<int>   swIdx = array.new<int>()
        array<int>   swT   = array.new<int>()   // 1 = high, -1 = low

        // mulai dari bar pertama, leg awal = naik
        int   dir    = 1
        float extP   = topArr.get(0)
        int   extIdx = 0
        float oppP   = botArr.get(0)
        int   oppIdx = 0

        for idx = 1 to bar_index
            float topB = topArr.get(idx)
            float botB = botArr.get(idx)

            if dir == 1
                if topB > extP
                    // puncak baru lebih tinggi -> ganti, lembah dihitung ulang
                    extP   := topB
                    extIdx := idx
                    oppP   := botB
                    oppIdx := idx
                else
                    if botB < oppP
                        oppP   := botB
                        oppIdx := idx
                    if oppIdx - extIdx >= swingMinBars and f_validSH(topArr, botArr, extIdx, idx)
                        swP.push(extP)
                        swIdx.push(extIdx)
                        swT.push(1)
                        dir    := -1
                        extP   := oppP
                        extIdx := oppIdx
                        // cari puncak body tertinggi setelah lembah baru
                        oppP   := topArr.get(extIdx)
                        oppIdx := extIdx
                        for j = extIdx to idx
                            if topArr.get(j) > oppP
                                oppP   := topArr.get(j)
                                oppIdx := j
            else
                if botB < extP
                    extP   := botB
                    extIdx := idx
                    oppP   := topB
                    oppIdx := idx
                else
                    if topB > oppP
                        oppP   := topB
                        oppIdx := idx
                    if oppIdx - extIdx >= swingMinBars and f_validSL(topArr, botArr, extIdx, idx)
                        swP.push(extP)
                        swIdx.push(extIdx)
                        swT.push(-1)
                        dir    := 1
                        extP   := oppP
                        extIdx := oppIdx
                        // cari lembah body terendah setelah puncak baru
                        oppP   := botArr.get(extIdx)
                        oppIdx := extIdx
                        for j = extIdx to idx
                            if botArr.get(j) < oppP
                                oppP   := botArr.get(j)
                                oppIdx := j

        // swing terakhir (leg yang masih berjalan)
        swP.push(extP)
        swIdx.push(extIdx)
        swT.push(dir)

        // cari swing high terakhir (dari belakang)
        int   lastSHIdx   = na
        float lastSHPrice = na
        for k = swP.size() - 1 to 0
            if swT.get(k) == 1
                lastSHIdx   := swIdx.get(k)
                lastSHPrice := swP.get(k)
                break

        // harga garis pink: telusuri ke kiri dari SH terakhir
        float pinkPrice = lastSHPrice
        if not na(lastSHIdx) and lastSHIdx > 0
            for i = lastSHIdx - 1 to 0
                float tb = topArr.get(i)
                float bb = botArr.get(i)

                // acuan menyentuh body candle ini
                if pinkPrice >= bb and pinkPrice <= tb
                    pinkPrice := tb                 // acuan baru = body atas candle ini
                    if patFlag.get(i) == 1          // candle bagian pola -> stop
                        break

        if showLastSH and not na(lastSHIdx)
            lastSHLine := line.new(
                 x1 = timeArr.get(lastSHIdx), y1 = pinkPrice,
                 x2 = time,                   y2 = pinkPrice,
                 xloc   = xloc.bar_time,
                 extend = extend.both,
                 color  = lastSHLineCol,
                 width  = 2)


        // gambar garis + label (pakai waktu, bukan bar_index)
        for k = 0 to swP.size() - 1
            bool  isHigh = swT.get(k) == 1
            int   x      = timeArr.get(swIdx.get(k))
            float y      = swP.get(k)

            if k > 0
                zzLines.push(line.new(
                     x1 = timeArr.get(swIdx.get(k - 1)), y1 = swP.get(k - 1),
                     x2 = x, y2 = y,
                     xloc = xloc.bar_time,
                     color = zzLineCol, width = 1))

            swingLabels.push(label.new(
                 x = x,
                 y = y,
                 xloc = xloc.bar_time,
                 text = (isHigh ? "SH " : "SL ") + str.tostring(y, format.mintick),
                 style = isHigh ? label.style_label_down : label.style_label_up,
                 color = isHigh ? swingHighCol : swingLowCol,
                 textcolor = isHigh ? color.white : color.black,
                 size = size.tiny))