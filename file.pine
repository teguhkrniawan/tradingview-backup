while rbrPat.size() <= bar_index
    rbrPat.push(0)
    rbrBaseFlag.push(0)
    rbrBaseZone.push(-1)

// Semua candle base harus lolos cek base RBR (cermin f_baseMultiple)
f_baseMultipleRbr(int nBase, float pct) =>
    bool ok = true
    for j = 2 to nBase + 1
        if not f_wickVsBodyBaseRbr(open[j], high[j], low[j], close[j], pct, j)
            ok := false

        // base tidak boleh turun: low tiap candle tidak lebih rendah dari
        // low candle base sebelumnya (di kirinya)
        // if j < nBase + 1 and low[j] < low[j + 1]
        //     ok := false
    ok
    
// Kode 9: semua ekor bawah base harus >= ekor bawah (low) leg in
f_baseBawahRbrOk(int nBase) =>
    float lowLegIn = low[nBase + 2]
    bool ok = true
    for j = 2 to nBase + 1
        if low[j] < lowLegIn
            ok := false
    ok

// Kode 10: semua ekor atas base harus <= ekor atas (high) leg out
f_baseAtasRbrOk(int nBase) =>
    float highLegOut = high[1]
    bool ok = true
    for j = 2 to nBase + 1
        if high[j] > highLegOut
            ok := false
    ok

// Return: [n base, jumlah error, kode error]  (n base = 0 berarti tidak ditemukan)
f_rbr_multiple(int minBase, int maxBase, float pct, bool needRally) =>
    int    nFound   = 0
    int    errCount = 0
    string errCodes = ""

    bool rallyOut = not needRally or f_isBullish(open[1], close[1])

    if rallyOut
        bool okFvgOut = f_fvg_legout_rbr(high[2], low[0])

        for n = minBase to maxBase
            int k = n + 2

            bool okLegOut = f_legOut_valid_rbr(
                 open[1], high[1], low[1], close[1],
                 open[k], close[k])

            bool okLegIn  = f_legIn_valid_rbr(open[k], high[k], low[k], close[k])
            bool rallyIn  = not needRally or f_isBullish(open[k], close[k])

            // if okLegOut and okLegIn and rallyIn and f_baseMultipleRbr(n, pct)
            if okLegOut and okLegIn and rallyIn and f_baseMultipleRbr(n, pct) and f_baseBodyOk(n) and (devMode or f_jarakBaseOk(n, 0.5))
                bool okFvgIn  = f_fvg_legin_rbr(high[k + 1], low[n + 1])
                bool jarakOk  = f_jarakBaseOk(n, 0.5)
                bool tanpaFvg = not okFvgIn and not okFvgOut

                if not tanpaFvg or inputSensitifitas == 'LOW'
                    nFound := n

                    if tanpaFvg
                        errCount += 1
                        errCodes += "3 "
                    else
                        if not okFvgIn
                            errCount += 1
                            errCodes += "1 "
                        if not okFvgOut
                            errCount += 1
                            errCodes += "2 "

                    if not jarakOk
                        errCount += 1
                        errCodes += "4 "

                    if not f_bodyAvgOk(open[k], close[k], k)
                        errCount += 1
                        errCodes += "5 "

                    if not f_bodyAvgOk(open[1], close[1], 1)
                        errCount += 1
                        errCodes += "6 "

                    if not f_legInBodyOk(open[k], high[k], low[k], close[k])
                        errCount += 1
                        errCodes += "7 "

                    if not f_legOutBodyOk(open[1], high[1], low[1], close[1])
                        errCount += 1
                        errCodes += "8 "

                    if not f_baseBawahRbrOk(n)
                        errCount += 1
                        errCodes += "9 "

                    if not f_baseAtasRbrOk(n)
                        errCount += 1
                        errCodes += "10 "

                    break

    [nFound, errCount, str.trim(errCodes)]


[validSingle, errSingle, errCodeSingle] = f_dbd_single(
     open[3], high[3], low[3], close[3],     // C1
     open[2], high[2], low[2], close[2],     // C2
     open[1], high[1], low[1], close[1],     // C3
     low[4],  high[2],                       // FVG Leg In
     low[2],  high[0],                       // FVG Leg Out
     reqDrop,
     wickPct)

validSingle := validSingle and errSingle <= str.pos("ABCDEFGHIJK", inputMinGrade)   // <-- TARUH DI SINI

markSingle        = validSingle and barstate.isconfirmed and showArrow and showDbdSingle
markRectangleBase = validSingle and barstate.isconfirmed and showDbdSingle

if markSingle and not backtestMode
