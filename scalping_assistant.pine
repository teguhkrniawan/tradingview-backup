//@version=6
indicator('7seas_scalping_assistant v1.7', overlay = true, max_bars_back = 5000, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// Angka versi di akhir harus sama dengan versi publish library seven_seas_core (lihat halaman script library)
import michelle_lawardi/seven_seas_core/4 as core

// =====================================================================
//  INPUT
// =====================================================================
gDet = 'UFO / BASE'
inSens = input.string('LOW', 'Select Sensitivity', options = ['LOW', 'MEDIUM', 'HIGH'], group = gDet)
inAvgLb = input.int(100, 'Avg Body Lookback (Candles)', minval = 1, step = 1, group = gDet, tooltip = 'Jika diubah lebih dari 190, naikkan max_bars_back di indicator().')
inMinGrade = input.string('K', 'Min. Grade to Show', options = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K'], group = gDet, tooltip = 'Pilih C: tampil C, B, A. Pilih B: tampil B, A. K = tampilkan semua.')
inBaseBody = input.bool(true, 'Base Body Height vs. Leg In/Out (Base Body Must Not Be Larger)', group = gDet)

gShow = 'Tampilan'
inShowDbd = input.bool(true, 'Show DBD Zones', group = gShow)
inShowRbr = input.bool(true, 'Show RBR Zones', group = gShow)
inShowLbl = input.bool(true, 'Show Grade Labels', group = gShow)


gSw = 'Swing Indicator'
inShowZZ = input.bool(true, 'Show ZigZag Lines', group = gSw)
inSwBasis = input.string('Wick', 'Swing High/Low Source', options = ['Body', 'Wick'], group = gSw)

gDbg = 'Debug'
inOverlap = input.bool(false, 'Disable Overlap Score', group = gDbg)
inDevMode = input.bool(false, 'DEV MODE', group = gDbg, tooltip = 'Centang: rule Body Engulfed dinonaktifkan, zona yang body base-nya tertutup utuh tetap digambar dan ditandai kode 13 di tooltip. Tidak dicentang: Body Engulfed aktif, zona yang ketabrak tidak digambar.')

inShowCtrl = input.bool(true, 'Show Control Line', group = gSw)


inPinkCol = input.color(color.rgb(255, 105, 180), 'Upper Zone Color (Swing High Control Line)', group = gSw)
// inGreenCol = input.color(color.lime, 'Lower Zone Color (Swing Low Control Line)', group = gSw)
inGreenCol = input.color(color.rgb(0, 110, 0), 'Lower Zone Color (Swing Low Control Line)', group = gSw)

inManualPink = input.bool(false, "Manual Pink Control", group = gSw)
inPinkMan = input.price(1.0, "Pink Control Price", group = gSw)

inManualGreen = input.bool(false, "Manual Green Control", group = gSw)
inGreenMan = input.price(1.0, "Green Control Price", group = gSw)


inGapCnt = input.int(4, 'Jumlah Gap Garis Zona', minval = 1, maxval = 20, group = gSw, tooltip = 'Jumlah gap di tiap zona. Isi 4 berarti terbentuk 5 garis di zona atas dan 5 garis di zona bawah.')

inShowNotes = input.bool(false, 'Show Control Notes', group = gSw, tooltip = 'Tampilkan label catatan di kanan garis control: kenapa garis solid atau putus-putus, dan swing mana yang dilewati.')

inSendAlert = input.bool(false, 'Send Control Lines via Alert', group = gSw, tooltip = 'Kirim garis control atas dan bawah lewat alert() setiap kali nilainya berubah. Buat alert dengan kondisi "Any alert() function call".')
gTouch = 'Touch Info'
inShowTouch = input.bool(true, 'Show Touch Info (Kiri Bawah)', group = gTouch)
inTpLayer = input.int(4, 'Layer Mulai TP di Proximal', minval = 2, maxval = 21, group = gTouch, tooltip = 'Jika harga sudah mencapai garis ini (atau lebih dalam), TP dipindah dari TP Maximal ke proximal (garis 1).')

inMaxBack = input.int(1500, 'Max Candle ke Belakang (Gambar)', minval = 300, maxval = 4800, step = 100, group = gTouch, tooltip = 'Objek yang lebih tua dari jumlah candle ini tidak digambar. Kalau muncul error "historical buffer limit", turunkan angkanya di bawah nilai limit di pesan error.')
// inAtrLen = input.int(14, 'ATR Daily Length', minval = 1, group = gTouch)
inAtrSrc = input.source(close, 'Sumber ATR (pilih: Average True Range > ATR)', group = gTouch)

// =====================================================================
//  CORE
// =====================================================================
// var cfg = core.Config.new(sensitivity = inSens, devMode = true, avgLookback = inAvgLb, minGrade = inMinGrade, baseBodyCheck = inBaseBody, disableOverlap = inOverlap, swingBasis = inSwBasis)
var cfg = core.Config.new(sensitivity = inSens, devMode = true, avgLookback = inAvgLb, minGrade = inMinGrade, baseBodyCheck = inBaseBody, disableOverlap = inOverlap, swingBasis = inSwBasis, tag = 'scalping')
var store = core.newStore(cfg)

// true = rentang body base tertutup utuh oleh body satu candle di kanan zona
// true = rentang high-low base tertutup utuh oleh body satu candle di kanan zona
bodyEngulfed(core.Zone zn) =>
    float bt = store.hiA.get(zn.baseL)
    float bb = store.loA.get(zn.baseL)
    if zn.baseR > zn.baseL
        for c = zn.baseL + 1 to zn.baseR
            bt := math.max(bt, store.hiA.get(c))
            bb := math.min(bb, store.loA.get(c))
    bool hit = false
    int from = zn.start + core.shift(cfg)
    if from <= bar_index
        for k = from to bar_index
            if store.topA.get(k) >= bt and store.botA.get(k) <= bb
                hit := true
                break
    hit

// true jika swing sudah ditembus candle mana pun setelah terbentuk (sampai bar sekarang)
swingBroken(int idx, float p, bool isHigh) =>
    bool br = false
    if idx < bar_index
        for c = idx + 1 to bar_index
            float v = isHigh ? (inSwBasis == 'Wick' ? store.hiA.get(c) : store.topA.get(c)) : (inSwBasis == 'Wick' ? store.loA.get(c) : store.botA.get(c))
            if isHigh ? v > p : v < p
                br := true
                break
    br

// high tertinggi dari seluruh candle base zona
zoneBaseHi(core.Zone z) =>
    float h = store.hiA.get(z.baseL)
    if z.baseR > z.baseL
        for c = z.baseL + 1 to z.baseR
            h := math.max(h, store.hiA.get(c))
    h

// low terendah dari seluruh candle base zona
zoneBaseLo(core.Zone z) =>
    float l = store.loA.get(z.baseL)
    if z.baseR > z.baseL
        for c = z.baseL + 1 to z.baseR
            l := math.min(l, store.loA.get(c))
    l

// proximal ditentukan dari close candle setelah leg out (baseR + 2)
// dflt dipakai selama candle itu belum close
proxByClose(float bLo, float bHi, int baseR, float dflt) =>
    float r = dflt
    int c = baseR + 2
    if bar_index > c
        r := store.clsA.get(c) >= (bLo + bHi) / 2 ? bHi : bLo
    r

bodyEngulfDbg(core.Zone zn) =>
    float bt = store.topA.get(zn.baseL)
    float bb = store.botA.get(zn.baseL)
    for c = zn.baseL + 1 to zn.baseR
        bt := math.max(bt, store.topA.get(c))
        bb := math.min(bb, store.botA.get(c))
    int hitAt = -1
    for k = zn.start to bar_index
        if store.topA.get(k) >= bt and store.botA.get(k) <= bb
            hitAt := k
            break
    'baseL=' + str.tostring(zn.baseL) + ' baseR=' + str.tostring(zn.baseR) + ' start=' + str.tostring(zn.start) + '\nbaseTop=' + str.tostring(bt) + ' baseBot=' + str.tostring(bb) + '\nhitAt=' + str.tostring(hitAt) + ' lastBar=' + str.tostring(bar_index)

// Hilangkan label "Mandatory" dari tooltip bawaan library
cleanTip(string t) =>
    string r = t
    if str.contains(r, 'Non mandatory (skor):')
        // gabungkan error 4/7/8/11 ke bagian "Non mandatory"
        r := str.replace_all(r, '\n\nMandatory (lolos karena DEV MODE):', '')
    else
        // hanya ada bagian "Mandatory": ganti judulnya
        r := str.replace_all(r, 'Mandatory (lolos karena DEV MODE):', 'Non mandatory (skor):')
    r

// batas tinggi area: ATR daily * 10 * 20%, lalu * 25%
// ATR pakem: selalu dari indikator ATR di chart (harus diset Timeframe = 1 day)
// batas tinggi area = ATR * 10 * 20% * 25%
float atrLim = inAtrSrc * 10 * 0.2 * 0.25
bool atrSrcOk = inAtrSrc != close



// Tambahkan kode 13 ke tooltip jika zona ketabrak tapi tetap digambar (DEV MODE)
tipEngulf(string t, bool engulfed) =>
    string r = cleanTip(t)
    if engulfed
        r := r + '\n\nMandatory (lolos karena DEV MODE):\n[13] Rentang high-low base tertutup utuh oleh body candle di kanan'
    r

// WAJIB dipanggil di setiap bar
[newDbd, newRbr] = core.update(store)

alertcondition(newDbd, 'DBD baru', 'Zona DBD baru terbentuk')
alertcondition(newRbr, 'RBR baru', 'Zona RBR baru terbentuk')

// =====================================================================
//  DRAWING STATE
// =====================================================================
var array<box> bxs = array.new<box>()
var array<label> lbs = array.new<label>()
var array<line> lns = array.new<line>()

var float lastSentPink = na
var float lastSentGreen = na

const int LOG_ROWS = 5
varip int sellMax = 0
varip int buyMax = 0
varip bool sellLock = false
varip bool buyLock = false
varip float lastFloorPx = na
varip float lastRoofPx = na
varip bool ready = false
varip int lastClBar = -1
varip int lastPrevBar = -1
varip float lkPink = na
varip float lkGreen = na
varip int lkPinkStart = na
varip int lkGreenStart = na
varip bool lkPinkValid = false
varip bool lkGreenValid = false
varip bool touchedLower = false
varip array<string> logS = array.new<string>()
varip array<string> logB = array.new<string>()
var table sellTbl = table.new(position.bottom_left, 1, 3 + LOG_ROWS, border_width = 0)
var table buyTbl = table.new(position.bottom_right, 1, 3 + LOG_ROWS, border_width = 0)

varip int flKey = na
varip bool flConf = true
varip int rfKey = na
varip bool rfConf = true

varip float flProx = na
varip float rfProx = na

varip bool flLogged = false
varip bool rfLogged = false

addLog(array<string> arr, string m) =>
    if ready
        arr.push(str.format_time(time, 'HH:mm', 'GMT+7') + '  ' + m)
        if arr.size() > LOG_ROWS
            arr.shift()

addLogAt(array<string> arr, string m, int t) =>
    if ready
        arr.push(str.format_time(t, 'HH:mm', 'GMT+7') + '  ' + m)
        if arr.size() > LOG_ROWS
            arr.shift()

// if newDbd
//     core.Zone nz = store.dbd.last()
//     float npy = store.hiA.get(nz.baseL)
//     for c = nz.baseL + 1 to nz.baseR
//         npy := math.max(npy, store.hiA.get(c))
//     addLog(logB, 'Terbentuk calon atap baru , proximal ' + str.tostring(npy, format.mintick))

// =====================================================================
//  GAMBAR (hanya di bar terakhir)
//  Semua objek ditempel ke nomor candle (xloc.bar_index) supaya selalu
//  pas di candle yang sama saat chart digeser / di-scale.
//  Batas TradingView: objek maksimal ~4900 candle ke belakang.
// =====================================================================
if barstate.islast
    int minX = math.max(bar_index - inMaxBack, 0)

    while bxs.size() > 0
        box.delete(bxs.pop())
    while lbs.size() > 0
        label.delete(lbs.pop())
    while lns.size() > 0
        line.delete(lns.pop())

    table.cell(sellTbl, 0, 0, inShowTouch ? 'SELL INFO' : '', text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.gray, 40))
    table.cell(sellTbl, 0, 1, inShowTouch ? 'SELL: -' : '', text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 30))
    table.cell(buyTbl, 0, 0, inShowTouch ? 'BUY INFO' : '', text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.gray, 40))
    table.cell(buyTbl, 0, 1, inShowTouch ? 'BUY: -' : '', text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 30))
    for r = 2 to 1 + LOG_ROWS
        table.cell(sellTbl, 0, r, '', text_color = color.white, text_size = size.small, text_halign = text.align_left)
        table.cell(buyTbl, 0, r, '', text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(sellTbl, 0, 2 + LOG_ROWS, '', height = 4, bgcolor = na)
    table.cell(buyTbl, 0, 2 + LOG_ROWS, '', height = 4, bgcolor = na)

    core.resolveOverlap(store)

    array<int> drawnDbd = array.new_int()
    array<int> drawnRbr = array.new_int()

    // ---------- Zona DBD ----------
    if inShowDbd and store.dbd.size() > 0
        int drawn = 0
        for zi = store.dbd.size() - 1 to 0
            if drawn >= 240
                break
            core.Zone zn = store.dbd.get(zi)
            if not zn.supp and (inDevMode or not bodyEngulfed(zn)) and zn.right >= minX
                color col = zn.isSingle ? color.blue : color.orange
                bxs.push(box.new(left = math.max(zn.left, minX), top = zn.top, right = zn.right, bottom = zn.bot, xloc = xloc.bar_index, border_color = col, border_width = 1, bgcolor = color.new(col, 85)))
                if inShowLbl and zn.lblX >= minX
                    // lbs.push(label.new(x = zn.lblX, y = zn.top, xloc = xloc.bar_index, text = zn.txt, style = label.style_label_down, color = zn.isSingle ? color.yellow : color.orange, textcolor = color.black, size = size.tiny, tooltip = tipEngulf(zn.tip, inDevMode and bodyEngulfed(zn)) + '\n\n' + bodyEngulfDbg(zn)))
                    lbs.push(label.new(x = zn.lblX, y = zn.top, xloc = xloc.bar_index, text = zn.txt, style = label.style_label_down, color = zn.isSingle ? color.yellow : color.orange, textcolor = color.black, size = size.tiny, tooltip = tipEngulf(zn.tip, inDevMode and bodyEngulfed(zn))))
                drawnDbd.push(zi)
                drawn += 1

    // ---------- Zona RBR ----------
    if inShowRbr and store.rbr.size() > 0
        int drawn = 0
        for zi = store.rbr.size() - 1 to 0
            if drawn >= 240
                break
            core.Zone zn = store.rbr.get(zi)
            if not zn.supp and (inDevMode or not bodyEngulfed(zn)) and zn.right >= minX
                color col = zn.isSingle ? color.green : color.teal
                bxs.push(box.new(left = math.max(zn.left, minX), top = zn.top, right = zn.right, bottom = zn.bot, xloc = xloc.bar_index, border_color = col, border_width = 1, bgcolor = color.new(col, 85)))
                if inShowLbl and zn.lblX >= minX
                    // lbs.push(label.new(x = zn.lblX, y = zn.bot, xloc = xloc.bar_index, text = zn.txt, style = label.style_label_up, color = col, textcolor = zn.isSingle ? color.black : color.white, size = size.tiny, tooltip = tipEngulf(zn.tip, inDevMode and bodyEngulfed(zn)) + '\n\n' + bodyEngulfDbg(zn)))
                    lbs.push(label.new(x = zn.lblX, y = zn.bot, xloc = xloc.bar_index, text = zn.txt, style = label.style_label_up, color = col, textcolor = zn.isSingle ? color.black : color.white, size = size.tiny, tooltip = tipEngulf(zn.tip, inDevMode and bodyEngulfed(zn)) ))
                drawnRbr.push(zi)
                drawn += 1

    // ---------- Swing (ZigZag) ----------
    [swP, swIdx, swT] = core.swingPivots(store)

    if inShowZZ and swP.size() > 1
        int st = math.max(1, swP.size() - 300)
        for k = st to swP.size() - 1
            int xa = swIdx.get(k - 1)
            int xb = swIdx.get(k)
            if xa >= minX
                lns.push(line.new(x1 = xa, y1 = swP.get(k - 1), x2 = xb, y2 = swP.get(k), xloc = xloc.bar_index, color = chart.fg_color, width = 1))

    // ---------- Garis Control ----------
    pink = core.controlLine(store, true, swP, swIdx, swT)
    green = core.controlLine(store, false, swP, swIdx, swT)

    // ---------- Pilih swing acuan otomatis: high harus di atas harga, low harus di bawah harga ----------
    float lastSwH = na
    float lastSwL = na
    int lastSwHIdx = na
    int lastSwLIdx = na
    if swP.size() > 0
        for k = swP.size() - 1 to 0
            if swT.get(k) == 1 and na(lastSwH) and swP.get(k) > close and not swingBroken(swIdx.get(k), swP.get(k), true)
                lastSwH := swP.get(k)
                lastSwHIdx := swIdx.get(k)
            if swT.get(k) == -1 and na(lastSwL) and swP.get(k) < close and not swingBroken(swIdx.get(k), swP.get(k), false)
                lastSwL := swP.get(k)
                lastSwLIdx := swIdx.get(k)
            if not na(lastSwH) and not na(lastSwL)
                break

    float pinkY = pink.exists ? (inManualPink ? inPinkMan : lastSwH) : na
    float greenY = green.exists ? (inManualGreen ? inGreenMan : lastSwL) : na
    bool pinkOk = not na(pinkY)
    bool greenOk = not na(greenY)

   

    // ---------- Validasi ulang (manual DAN otomatis, karena swing acuan bisa beda dari library) ----------
    core.ControlLine pinkCl = pink
    if pinkOk
        pinkCl := core.controlLineAt(store, true, swP, swIdx, swT, pinkY)

    core.ControlLine greenCl = green
    if greenOk
        greenCl := core.controlLineAt(store, false, swP, swIdx, swT, greenY)

    // Solid hanya jika zona yang kena benar-benar tergambar di chart
    bool pinkValid = pinkOk and pinkCl.valid
    if pinkValid
        int zidChkP = na(pinkCl.hitIdx) ? -1 : store.baseZone.get(pinkCl.hitIdx)
        pinkValid := zidChkP >= 0 and drawnDbd.includes(zidChkP)

    bool greenValid = greenOk and greenCl.valid
    if greenValid
        int zidChkG = na(greenCl.hitIdx) ? -1 : store.rbrBaseZone.get(greenCl.hitIdx)
        greenValid := zidChkG >= 0 and drawnRbr.includes(zidChkG)

    // ---------- Titik awal garis ----------
    int pinkStart = (inManualPink or na(lastSwHIdx)) ? pink.swingIdx : lastSwHIdx
    if pinkValid and not na(pinkCl.hitIdx)
        pinkStart := pinkCl.hitIdx
        int zidP = store.baseZone.get(pinkCl.hitIdx)
        if zidP >= 0 and zidP < store.dbd.size()
            pinkStart := store.dbd.get(zidP).left

    int greenStart = (inManualGreen or na(lastSwLIdx)) ? green.swingIdx : lastSwLIdx
    if greenValid and not na(greenCl.hitIdx)
        greenStart := greenCl.hitIdx
        int zidG = store.rbrBaseZone.get(greenCl.hitIdx)
        if zidG >= 0 and zidG < store.rbr.size()
            greenStart := store.rbr.get(zidG).left

    // ---------- Garis pink harus di atas base DBD tertinggi di area yang kena ----------
    if pinkValid and not inManualPink
        core.Zone hzP = store.dbd.get(store.baseZone.get(pinkCl.hitIdx))
        float hiBase = na
        for zi = 0 to store.dbd.size() - 1
            if not drawnDbd.includes(zi)
                continue
            core.Zone z = store.dbd.get(zi)
            if z.left >= hzP.left and z.bot <= hzP.top and z.top >= hzP.bot
                float b = zoneBaseHi(z)
                hiBase := na(hiBase) ? b : math.max(hiBase, b)
        if not na(hiBase)
            pinkY := math.max(pinkY, hiBase + syminfo.mintick)

    // ---------- Garis hijau harus di bawah base RBR terendah di area yang kena ----------
    if greenValid and not inManualGreen
        core.Zone hzG = store.rbr.get(store.rbrBaseZone.get(greenCl.hitIdx))
        float loBase = na
        for zi = 0 to store.rbr.size() - 1
            if not drawnRbr.includes(zi)
                continue
            core.Zone z = store.rbr.get(zi)
            if z.left >= hzG.left and z.bot <= hzG.top and z.top >= hzG.bot
                float b = zoneBaseLo(z)
                loBase := na(loBase) ? b : math.min(loBase, b)
        if not na(loBase)
            greenY := math.min(greenY, loBase - syminfo.mintick)

    // ---------- Kunci garis control selama setup (berubah hanya setelah cut loss) ----------
    if not na(lkPink) and not inManualPink
        pinkY := lkPink
        pinkStart := lkPinkStart
        pinkValid := lkPinkValid
    if not na(lkGreen) and not inManualGreen
        greenY := lkGreen
        greenStart := lkGreenStart
        greenValid := lkGreenValid

    pinkOk := not na(pinkY)
    greenOk := not na(greenY)

    if inManualPink
        lkPink := na
    if inManualGreen
        lkGreen := na

    bool setupValid = pinkOk and greenOk and pinkY > greenY and pinkValid and greenValid
    if setupValid
        if na(lkPink) and not inManualPink
            lkPink := pinkY
            lkPinkStart := pinkStart
            lkPinkValid := pinkValid
        if na(lkGreen) and not inManualGreen
            lkGreen := greenY
            lkGreenStart := greenStart
            lkGreenValid := greenValid

    int pinkX = pinkOk ? math.max(pinkStart, minX) : na
    int greenX = greenOk ? math.max(greenStart, minX) : na

    // ---------- Kirim garis control via alert (hanya jika berubah) ----------
    if inSendAlert and pinkOk and greenOk
        if na(lastSentPink) or na(lastSentGreen) or pinkY != lastSentPink or greenY != lastSentGreen
            string payload = '{"symbol":"' + syminfo.tickerid + '","tf":"' + timeframe.period + '","upper":' + str.tostring(pinkY, format.mintick) + ',"lower":' + str.tostring(greenY, format.mintick) + ',"manualUpper":' + str.tostring(inManualPink) + ',"manualLower":' + str.tostring(inManualGreen) + ',"time":' + str.tostring(time) + '}'
            alert(payload, alert.freq_once_per_bar_close)
            lastSentPink := pinkY
            lastSentGreen := greenY

    if inShowCtrl and pinkOk
        lns.push(line.new(x1 = pinkX, y1 = pinkY, x2 = bar_index, y2 = pinkY, xloc = xloc.bar_index, extend = extend.right, color = inPinkCol, style = pinkValid ? line.style_solid : line.style_dashed, width = 1))
        if inShowNotes
            lbs.push(label.new(x = bar_index + 3, y = pinkY, xloc = xloc.bar_index, text = core.controlText(store, pinkCl, true), style = label.style_label_lower_left, color = color.new(color.black, 20), textcolor = inPinkCol, textalign = text.align_left, size = size.small))

    if inShowCtrl and greenOk
        lns.push(line.new(x1 = greenX, y1 = greenY, x2 = bar_index, y2 = greenY, xloc = xloc.bar_index, extend = extend.right, color = inGreenCol, style = greenValid ? line.style_solid : line.style_dashed, width = 1))
        if inShowNotes
            lbs.push(label.new(x = bar_index + 3, y = greenY, xloc = xloc.bar_index, text = core.controlText(store, greenCl, false), style = label.style_label_upper_left, color = color.new(color.black, 20), textcolor = inGreenCol, textalign = text.align_left, size = size.small))    

    // ---------- Zona Entry (25%) ----------
    if pinkOk and greenOk and pinkY > greenY

        int touchUp = 0
        int touchLo = 0

        [topB, botB, tpP] = core.fibZones(pinkY, greenY, 0.25)
        int fibLeft = math.max(pinkX, greenX)
        lns.push(line.new(x1 = fibLeft, y1 = tpP, x2 = bar_index, y2 = tpP, xloc = xloc.bar_index, extend = extend.right, color = color.gray, width = 1))

        for g = 0 to inGapCnt
            float f = g / float(inGapCnt)
            float yUp = pinkY - (pinkY - topB) * f
            float yLo = botB + (greenY - botB) * f
            if high >= yUp
                touchUp := math.max(touchUp, inGapCnt - g + 1)
            if low <= yLo
                touchLo := math.max(touchLo, g + 1)
            lns.push(line.new(x1 = fibLeft, y1 = yUp, x2 = bar_index, y2 = yUp, xloc = xloc.bar_index, extend = extend.right, color = inPinkCol, width = 1))
            lns.push(line.new(x1 = fibLeft, y1 = yLo, x2 = bar_index, y2 = yLo, xloc = xloc.bar_index, extend = extend.right, color = inGreenCol, width = 1))
            //lbs.push(label.new(x = fibLeft, y = yUp, xloc = xloc.bar_index, text = str.tostring(inGapCnt - g + 1), style = label.style_label_right, color = color.new(color.black, 50), textcolor = color.white, size = size.small))
            //lbs.push(label.new(x = fibLeft, y = yLo, xloc = xloc.bar_index, text = str.tostring(g + 1), style = label.style_label_right, color = color.new(color.black, 50), textcolor = color.white, size = size.small))

        float zoneH = pinkY - topB

        // info ATR di header (sumber pakem: indikator ATR Daily)
        string atrTxt = 'ATR: ' + str.tostring(atrLim, format.mintick)
        bool atrOver = atrSrcOk and zoneH > atrLim
        string atrWarn = not atrSrcOk ? '  |  PILIH SUMBER ATR (indikator ATR Daily)' : (atrOver ? '  |  WARNING! Area Buy/Sell > ATR (' + atrTxt + ')' : '  |  Tidak Ada Warning ATR (' + atrTxt + ')')
        table.cell(sellTbl, 0, 0, inShowTouch ? 'SELL INFO' + atrWarn : '', text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = (atrOver or not atrSrcOk) ? color.new(color.red, 30) : color.new(color.gray, 40))

        float slUp = pinkY + zoneH * 0.2
        float slLo = greenY - zoneH * 0.2
        lns.push(line.new(x1 = fibLeft, y1 = slUp, x2 = bar_index, y2 = slUp, xloc = xloc.bar_index, extend = extend.right, color = color.red, width = 1))
        lns.push(line.new(x1 = fibLeft, y1 = slLo, x2 = bar_index, y2 = slLo, xloc = xloc.bar_index, extend = extend.right, color = color.red, width = 1))
        // lbs.push(label.new(x = fibLeft, y = slUp, xloc = xloc.bar_index, text = 'CL', style = label.style_label_right, color = color.new(color.black, 50), textcolor = color.white, size = size.small))
        // lbs.push(label.new(x = fibLeft, y = slLo, xloc = xloc.bar_index, text = 'CL', style = label.style_label_right, color = color.new(color.black, 50), textcolor = color.white, size = size.small))

        // ---------- Memory trader + warning ----------
        

        // 2) Lock dilepas setelah harga benar-benar keluar dari zona
        if touchUp == 0
            sellLock := false
        if touchLo == 0
            buyLock := false

        // 3) Masuk / naik layer (dicatat satu per satu, dengan harga garis layer)
        if not sellLock and touchUp > sellMax
            int prevS = sellMax
            sellMax := touchUp
            for l = prevS + 1 to sellMax
                float gS = inGapCnt + 1 - l
                float pxS = pinkY - (pinkY - topB) * gS / inGapCnt
                string pS = str.tostring(pxS, format.mintick)
                addLog(logS, 'PO SELL layer ' + str.tostring(l) + ' terisi di ' + pS)
            if sellMax >= inTpLayer and prevS < inTpLayer
                addLog(logS, 'SELL layer ' + str.tostring(sellMax) + ': TP di PROXIMAL (layer 1)')

        if not buyLock and touchLo > buyMax
            int prevB = buyMax
            buyMax := touchLo
            for l = prevB + 1 to buyMax
                float gB = l - 1
                float pxB = botB + (greenY - botB) * gB / inGapCnt
                string pB = str.tostring(pxB, format.mintick)
                addLog(logB, 'PO BUY layer ' + str.tostring(l) + ' terisi di ' + pB)
            if buyMax >= inTpLayer and prevB < inTpLayer
                addLog(logB, 'BUY layer ' + str.tostring(buyMax) + ': TP di PROXIMAL (layer 1)')

       

        // 3c) Cut loss: candle close melewati garis CL (merah)
        // A: candle yang baru close (replay forward / close candle live)
        if barstate.isconfirmed and bar_index != lastClBar
            lastClBar := bar_index
            bool clUpA = close > slUp
            bool clLoA = close < slLo
            if sellMax > 0 and clUpA
                addLog(logS, 'CUT LOSS SELL! candle close di atas garis CL ' + str.tostring(slUp, format.mintick) + ' (dari layer ' + str.tostring(sellMax) + ')')
                sellMax := 0
                sellLock := true
            if buyMax > 0 and clLoA
                addLog(logB, 'CUT LOSS BUY! candle close di bawah garis CL ' + str.tostring(slLo, format.mintick) + ' (dari layer ' + str.tostring(buyMax) + ')')
                buyMax := 0
                buyLock := true
            if clUpA or clLoA
                lkPink := na
                lkGreen := na

        // B: cadangan, kalau close candle sebelumnya terlewat
        if bar_index != lastPrevBar
            lastPrevBar := bar_index
            if lastClBar != bar_index - 1 and lastClBar != bar_index
                bool clUpB = close[1] > slUp
                bool clLoB = close[1] < slLo
                if sellMax > 0 and clUpB
                    addLogAt(logS, 'CUT LOSS SELL! candle close di atas garis CL ' + str.tostring(slUp, format.mintick) + ' (dari layer ' + str.tostring(sellMax) + ')', time[1])
                    sellMax := 0
                    sellLock := true
                if buyMax > 0 and clLoB
                    addLogAt(logB, 'CUT LOSS BUY! candle close di bawah garis CL ' + str.tostring(slLo, format.mintick) + ' (dari layer ' + str.tostring(buyMax) + ')', time[1])
                    buyMax := 0
                    buyLock := true
                if clUpB or clLoB
                    lkPink := na
                    lkGreen := na

        // 4) TP: pakai harga saat ini
        if sellMax > 0
            bool proxS = sellMax >= inTpLayer
            if close <= (proxS ? topB : tpP)
                addLog(logS, 'TP SELL SEKARANG: harga di ' + (proxS ? 'proximal (layer 1)' : 'TP Maximal'))
                sellMax := 0
                sellLock := true

        if buyMax > 0
            bool proxB = buyMax >= inTpLayer
            if close >= (proxB ? botB : tpP)
                addLog(logB, 'TP BUY SEKARANG: harga di ' + (proxB ? 'proximal (layer 1)' : 'TP Maximal'))
                buyMax := 0
                buyLock := true

        // 5) Status SELL / BUY (tabel terpisah)
        if inShowTouch
            string upTxt = 'SELL: -'
            string loTxt = 'BUY: -'
            if sellMax > 0
                upTxt := 'SELL AKTIF | max layer ' + str.tostring(sellMax) + ' | TP: ' + (sellMax >= inTpLayer ? 'proximal' : 'TP Maximal')
            else if touchUp > 0
                upTxt := 'SELL: selesai, menunggu area baru'
            if buyMax > 0
                loTxt := 'BUY AKTIF | max layer ' + str.tostring(buyMax) + ' | TP: ' + (buyMax >= inTpLayer ? 'proximal' : 'TP Maximal')
            else if touchLo > 0
                loTxt := 'BUY: selesai, menunggu area baru'

            // loTxt += '  [dbg low=' + str.tostring(low, format.mintick) + ' touchLo=' + str.tostring(touchLo) + ' bar=' + str.tostring(bar_index) + ']'
            // upTxt += '  [dbg high=' + str.tostring(high, format.mintick) + ' touchUp=' + str.tostring(touchUp) + ']'

            table.cell(sellTbl, 0, 1, upTxt, text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 30))
            table.cell(buyTbl, 0, 1, loTxt, text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 30))

        // 6) Calon lantai baru + confirm
        float floorPx = na   // proximal (hasil aturan close)
        float floorLo = na   // low terendah base
        float floorHi = na   // high tertinggi base
        int floorKey = na
        int floorBaseR = na
        for zi = store.rbr.size() - 1 to 0
            if store.rbr.size() == 0
                break
            core.Zone fz = store.rbr.get(zi)
            if fz.left < fibLeft or (store.rbr.size() - 1 - zi) >= 20
                break
            if not drawnRbr.includes(zi)
                continue
            float px = store.loA.get(fz.baseL)
            float minLow = math.min(store.loA.get(fz.baseL), low)
            for c = fz.baseL + 1 to bar_index
                if c <= fz.baseR
                    px := math.min(px, store.loA.get(c))
                minLow := math.min(minLow, store.loA.get(c))
            if px > botB and px < pinkY and minLow > botB
                floorLo := px
                floorHi := zoneBaseHi(fz)
                floorKey := fz.baseL
                floorBaseR := fz.baseR
                floorPx := proxByClose(floorLo, floorHi, floorBaseR, floorLo)
                break
        if not na(floorPx)
            if na(flKey) or floorKey != flKey
                flKey := floorKey
                flConf := false
                flLogged := false
            // log hanya sekali, setelah candle setelah leg out close (proximal sudah final)
            if not flLogged and bar_index > floorBaseR + 2
                string pF = str.tostring(floorPx, format.mintick)
                string msgFl = 'Terbentuk calon lantai baru (unverified) di harga ' + pF + ' (proximal)'
                string msgFlExit = 'Terbentuk calon lantai baru (unverified) + exit di harga ' + pF + ' (proximal)'
                addLog(logS, (sellMax > 0 and floorPx < tpP) ? msgFlExit : msgFl)
                addLog(logB, (buyMax > 0 and floorPx > tpP) ? msgFlExit : msgFl)
                flLogged := true
            if flLogged and not flConf
                bool hitFl = false
                for c = floorBaseR + 2 to bar_index
                    if store.hiA.get(c) >= floorLo and store.loA.get(c) <= floorHi
                        hitFl := true
                        break
                if hitFl
                    string msgFlC = 'Terbentuk lantai confirm di harga ' + str.tostring(floorPx, format.mintick) + ' (proximal)'
                    addLog(logS, msgFlC)
                    addLog(logB, msgFlC)
                    flConf := true
        else
            flKey := na
            flLogged := false

        // 7) Calon atap baru + confirm
        float roofPx = na   // proximal (hasil aturan close)
        float roofHi = na   // high tertinggi base
        float roofLo = na   // low terendah base
        int roofKey = na
        int roofBaseR = na
        int checkedD = 0
        for zi = store.dbd.size() - 1 to 0
            core.Zone rz = store.dbd.get(zi)
            if rz.baseL < fibLeft or checkedD >= 30
                break
            if not drawnDbd.includes(zi)
                continue
            checkedD += 1
            float py = store.hiA.get(rz.baseL)
            float maxHigh = math.max(store.hiA.get(rz.baseL), high)
            for c = rz.baseL + 1 to bar_index
                if c <= rz.baseR
                    py := math.max(py, store.hiA.get(c))
                maxHigh := math.max(maxHigh, store.hiA.get(c))
            if py < topB and py > greenY and maxHigh < topB
                roofHi := py
                roofLo := zoneBaseLo(rz)
                roofKey := rz.baseL
                roofBaseR := rz.baseR
                roofPx := proxByClose(roofLo, roofHi, roofBaseR, roofHi)
                break
        if not na(roofPx)
            if na(rfKey) or roofKey != rfKey
                rfKey := roofKey
                rfConf := false
                rfLogged := false
            if not rfLogged and bar_index > roofBaseR + 2
                string pR = str.tostring(roofPx, format.mintick)
                string msgRf = 'Terbentuk calon atap baru (unverified) di harga ' + pR + ' (proximal)'
                string msgRfExit = 'Terbentuk calon atap baru (unverified) + exit di harga ' + pR + ' (proximal)'
                addLog(logS, (sellMax > 0 and roofPx < tpP) ? msgRfExit : msgRf)
                addLog(logB, (buyMax > 0 and roofPx > tpP) ? msgRfExit : msgRf)
                rfLogged := true
            if rfLogged and not rfConf
                bool hitRf = false
                for c = roofBaseR + 2 to bar_index
                    if store.hiA.get(c) >= roofLo and store.loA.get(c) <= roofHi
                        hitRf := true
                        break
                if hitRf
                    string msgRfC = 'Terbentuk atap confirm di harga ' + str.tostring(roofPx, format.mintick) + ' (proximal)'
                    addLog(logS, msgRfC)
                    addLog(logB, msgRfC)
                    rfConf := true
        else
            rfKey := na
            rfLogged := false

        
    // ---------- Log berjalan SELL & BUY (terbaru di atas) ----------
    if inShowTouch
        for i = 0 to LOG_ROWS - 1
            string ts = ''
            string tb = ''
            if i < logS.size()
                ts := logS.get(logS.size() - 1 - i)
            if i < logB.size()
                tb := logB.get(logB.size() - 1 - i)
            table.cell(sellTbl, 0, 2 + i, ts, text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = ts == '' ? na : color.new(color.black, 30))
            table.cell(buyTbl, 0, 2 + i, tb, text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = tb == '' ? na : color.new(color.black, 30))

    table.cell(buyTbl, 0, 0, 'BUY INFO | bar=' + str.tostring(bar_index) + ' pinkOk=' + str.tostring(pinkOk) + ' greenOk=' + str.tostring(greenOk) + ' pV=' + str.tostring(pinkValid) + ' gV=' + str.tostring(greenValid) + ' lkG=' + str.tostring(lkGreen, format.mintick) + ' gY=' + str.tostring(greenY, format.mintick) + ' low=' + str.tostring(low, format.mintick), text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.gray, 40))


    ready := true