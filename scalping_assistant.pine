//@version=6
indicator('7seas_scalping_assistant v1.3', overlay = true, max_bars_back = 5000, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// Angka versi di akhir harus sama dengan versi publish library seven_seas_core (lihat halaman script library)
import michelle_lawardi/seven_seas_core/2 as core

// =====================================================================
//  INPUT
// =====================================================================
gDet = 'UFO / BASE'
inSens = input.string('LOW', 'Select Sensitivity', options = ['LOW', 'MEDIUM', 'HIGH'], group = gDet)
inAvgLb = input.int(100, 'Avg Body Lookback (Candles)', minval = 1, step = 1, group = gDet, tooltip = 'Jika diubah lebih dari 190, naikkan max_bars_back di indicator().')
inMinGrade = input.string('K', 'Min. Grade to Show', options = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K'], group = gDet, tooltip = 'Pilih C: tampil C, B, A. Pilih B: tampil B, A. K = tampilkan semua.')
inBaseBody = input.bool(true, 'Base Body Height vs. Leg In/Out (Base Body Must Not Be Larger)', group = gDet)

gShow = 'Tampilan'
inShowDbd = input.bool(true, 'Show DBD Zones', group = gShow)
inShowRbr = input.bool(true, 'Show RBR Zones', group = gShow)
inShowLbl = input.bool(true, 'Show Grade Labels', group = gShow)


gSw = 'Swing Indicator'
inShowZZ = input.bool(true, 'Show ZigZag Lines', group = gSw)
inSwBasis = input.string('Wick', 'Swing High/Low Source', options = ['Body', 'Wick'], group = gSw)

gDbg = 'Debug'
inOverlap = input.bool(false, 'Disable Overlap Score', group = gDbg)
inDevMode = input.bool(false, 'DEV MODE', group = gDbg, tooltip = 'Centang: rule Body Engulfed dinonaktifkan, zona yang body base-nya tertutup utuh tetap digambar dan ditandai kode 13 di tooltip. Tidak dicentang: Body Engulfed aktif, zona yang ketabrak tidak digambar.')

inShowCtrl = input.bool(true, 'Show Control Line', group = gSw)


inPinkCol = input.color(color.rgb(255, 105, 180), 'Upper Zone Color (Swing High Control Line)', group = gSw)
inGreenCol = input.color(color.lime, 'Lower Zone Color (Swing Low Control Line)', group = gSw)

inManualPink = input.bool(false, "Manual Pink Control", group = gSw)
inPinkMan = input.price(1.0, "Pink Control Price", group = gSw)

inManualGreen = input.bool(false, "Manual Green Control", group = gSw)
inGreenMan = input.price(1.0, "Green Control Price", group = gSw)


inGapCnt = input.int(4, 'Jumlah Gap Garis Zona', minval = 1, maxval = 20, group = gSw, tooltip = 'Jumlah gap di tiap zona. Isi 4 berarti terbentuk 5 garis di zona atas dan 5 garis di zona bawah.')

inShowNotes = input.bool(false, 'Show Control Notes', group = gSw, tooltip = 'Tampilkan label catatan di kanan garis control: kenapa garis solid atau putus-putus, dan swing mana yang dilewati.')

inSendAlert = input.bool(false, 'Send Control Lines via Alert', group = gSw, tooltip = 'Kirim garis control atas dan bawah lewat alert() setiap kali nilainya berubah. Buat alert dengan kondisi "Any alert() function call".')
gTouch = 'Touch Info'
inShowTouch = input.bool(true, 'Show Touch Info (Kiri Bawah)', group = gTouch)
inTpLayer = input.int(4, 'Layer Mulai TP di Proximal', minval = 2, maxval = 21, group = gTouch, tooltip = 'Jika harga sudah mencapai garis ini (atau lebih dalam), TP dipindah dari garis tengah ke proximal (garis 1).')

inMaxBack = input.int(1500, 'Max Candle ke Belakang (Gambar)', minval = 300, maxval = 4800, step = 100, group = gTouch, tooltip = 'Objek yang lebih tua dari jumlah candle ini tidak digambar. Kalau muncul error "historical buffer limit", turunkan angkanya di bawah nilai limit di pesan error.')

// =====================================================================
//  CORE
// =====================================================================
var cfg = core.Config.new(sensitivity = inSens, devMode = true, avgLookback = inAvgLb, minGrade = inMinGrade, baseBodyCheck = inBaseBody, disableOverlap = inOverlap, swingBasis = inSwBasis)
var store = core.newStore(cfg)

// true = rentang body base tertutup utuh oleh body satu candle di kanan zona
// true = rentang high-low base tertutup utuh oleh body satu candle di kanan zona
bodyEngulfed(core.Zone zn) =>
    float bt = store.hiA.get(zn.baseL)
    float bb = store.loA.get(zn.baseL)
    if zn.baseR > zn.baseL
        for c = zn.baseL + 1 to zn.baseR
            bt := math.max(bt, store.hiA.get(c))
            bb := math.min(bb, store.loA.get(c))
    bool hit = false
    for k = zn.start to bar_index
        if store.topA.get(k) >= bt and store.botA.get(k) <= bb
            hit := true
            break
    hit

bodyEngulfDbg(core.Zone zn) =>
    float bt = store.topA.get(zn.baseL)
    float bb = store.botA.get(zn.baseL)
    for c = zn.baseL + 1 to zn.baseR
        bt := math.max(bt, store.topA.get(c))
        bb := math.min(bb, store.botA.get(c))
    int hitAt = -1
    for k = zn.start to bar_index
        if store.topA.get(k) >= bt and store.botA.get(k) <= bb
            hitAt := k
            break
    'baseL=' + str.tostring(zn.baseL) + ' baseR=' + str.tostring(zn.baseR) + ' start=' + str.tostring(zn.start) + '\nbaseTop=' + str.tostring(bt) + ' baseBot=' + str.tostring(bb) + '\nhitAt=' + str.tostring(hitAt) + ' lastBar=' + str.tostring(bar_index)

// Hilangkan label "Mandatory" dari tooltip bawaan library
cleanTip(string t) =>
    string r = t
    if str.contains(r, 'Non mandatory (skor):')
        // gabungkan error 4/7/8/11 ke bagian "Non mandatory"
        r := str.replace_all(r, '\n\nMandatory (lolos karena DEV MODE):', '')
    else
        // hanya ada bagian "Mandatory": ganti judulnya
        r := str.replace_all(r, 'Mandatory (lolos karena DEV MODE):', 'Non mandatory (skor):')
    r

// Tambahkan kode 13 ke tooltip jika zona ketabrak tapi tetap digambar (DEV MODE)
tipEngulf(string t, bool engulfed) =>
    string r = cleanTip(t)
    if engulfed
        r := r + '\n\nMandatory (lolos karena DEV MODE):\n[13] Rentang high-low base tertutup utuh oleh body candle di kanan'
    r

// WAJIB dipanggil di setiap bar
[newDbd, newRbr] = core.update(store)

alertcondition(newDbd, 'DBD baru', 'Zona DBD baru terbentuk')
alertcondition(newRbr, 'RBR baru', 'Zona RBR baru terbentuk')

// =====================================================================
//  DRAWING STATE
// =====================================================================
var array<box> bxs = array.new<box>()
var array<label> lbs = array.new<label>()
var array<line> lns = array.new<line>()

var float lastSentPink = na
var float lastSentGreen = na

const int LOG_ROWS = 4
varip int sellMax = 0
varip int buyMax = 0
varip bool sellLock = false
varip bool buyLock = false
varip array<string> logS = array.new<string>()
varip array<string> logB = array.new<string>()
var table sellTbl = table.new(position.bottom_left, 1, 3 + LOG_ROWS, border_width = 0)
var table buyTbl = table.new(position.bottom_right, 1, 3 + LOG_ROWS, border_width = 0)

addLog(array<string> arr, string m) =>
    arr.push(str.format_time(time, 'HH:mm', 'GMT+7') + '  ' + m)
    if arr.size() > LOG_ROWS
        arr.shift()

// =====================================================================
//  GAMBAR (hanya di bar terakhir)
//  Semua objek ditempel ke nomor candle (xloc.bar_index) supaya selalu
//  pas di candle yang sama saat chart digeser / di-scale.
//  Batas TradingView: objek maksimal ~4900 candle ke belakang.
// =====================================================================
if barstate.islast
    int minX = math.max(bar_index - inMaxBack, 0)

    while bxs.size() > 0
        box.delete(bxs.pop())
    while lbs.size() > 0
        label.delete(lbs.pop())
    while lns.size() > 0
        line.delete(lns.pop())

        table.cell(sellTbl, 0, 0, inShowTouch ? 'SELL INFO' : '', text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.gray, 40))
    table.cell(sellTbl, 0, 1, inShowTouch ? 'SELL: -' : '', text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 30))
    table.cell(buyTbl, 0, 0, inShowTouch ? 'BUY INFO' : '', text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.gray, 40))
    table.cell(buyTbl, 0, 1, inShowTouch ? 'BUY: -' : '', text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 30))
    for r = 2 to 1 + LOG_ROWS
        table.cell(sellTbl, 0, r, '', text_color = color.white, text_size = size.small, text_halign = text.align_left)
        table.cell(buyTbl, 0, r, '', text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(buyTbl, 0, 2 + LOG_ROWS, '', height = 4, bgcolor = na)
    table.cell(sellTbl, 0, 2 + LOG_ROWS, '', height = 4, bgcolor = na)

    core.resolveOverlap(store)

    array<int> drawnDbd = array.new_int()
    array<int> drawnRbr = array.new_int()

    // ---------- Zona DBD ----------
    if inShowDbd and store.dbd.size() > 0
        int drawn = 0
        for zi = store.dbd.size() - 1 to 0
            if drawn >= 240
                break
            core.Zone zn = store.dbd.get(zi)
            if not zn.supp and (inDevMode or not bodyEngulfed(zn)) and zn.right >= minX
                color col = zn.isSingle ? color.blue : color.orange
                bxs.push(box.new(left = math.max(zn.left, minX), top = zn.top, right = zn.right, bottom = zn.bot, xloc = xloc.bar_index, border_color = col, border_width = 1, bgcolor = color.new(col, 85)))
                if inShowLbl and zn.lblX >= minX
                    // lbs.push(label.new(x = zn.lblX, y = zn.top, xloc = xloc.bar_index, text = zn.txt, style = label.style_label_down, color = zn.isSingle ? color.yellow : color.orange, textcolor = color.black, size = size.tiny, tooltip = tipEngulf(zn.tip, inDevMode and bodyEngulfed(zn)) + '\n\n' + bodyEngulfDbg(zn)))
                    lbs.push(label.new(x = zn.lblX, y = zn.top, xloc = xloc.bar_index, text = zn.txt, style = label.style_label_down, color = zn.isSingle ? color.yellow : color.orange, textcolor = color.black, size = size.tiny, tooltip = tipEngulf(zn.tip, inDevMode and bodyEngulfed(zn))))
                drawnDbd.push(zi)
                drawn += 1

    // ---------- Zona RBR ----------
    if inShowRbr and store.rbr.size() > 0
        int drawn = 0
        for zi = store.rbr.size() - 1 to 0
            if drawn >= 240
                break
            core.Zone zn = store.rbr.get(zi)
            if not zn.supp and (inDevMode or not bodyEngulfed(zn)) and zn.right >= minX
                color col = zn.isSingle ? color.green : color.teal
                bxs.push(box.new(left = math.max(zn.left, minX), top = zn.top, right = zn.right, bottom = zn.bot, xloc = xloc.bar_index, border_color = col, border_width = 1, bgcolor = color.new(col, 85)))
                if inShowLbl and zn.lblX >= minX
                    // lbs.push(label.new(x = zn.lblX, y = zn.bot, xloc = xloc.bar_index, text = zn.txt, style = label.style_label_up, color = col, textcolor = zn.isSingle ? color.black : color.white, size = size.tiny, tooltip = tipEngulf(zn.tip, inDevMode and bodyEngulfed(zn)) + '\n\n' + bodyEngulfDbg(zn)))
                    lbs.push(label.new(x = zn.lblX, y = zn.bot, xloc = xloc.bar_index, text = zn.txt, style = label.style_label_up, color = col, textcolor = zn.isSingle ? color.black : color.white, size = size.tiny, tooltip = tipEngulf(zn.tip, inDevMode and bodyEngulfed(zn)) ))
                drawnRbr.push(zi)
                drawn += 1

    // ---------- Swing (ZigZag) ----------
    [swP, swIdx, swT] = core.swingPivots(store)

    if inShowZZ and swP.size() > 1
        int st = math.max(1, swP.size() - 300)
        for k = st to swP.size() - 1
            int xa = swIdx.get(k - 1)
            int xb = swIdx.get(k)
            if xa >= minX
                lns.push(line.new(x1 = xa, y1 = swP.get(k - 1), x2 = xb, y2 = swP.get(k), xloc = xloc.bar_index, color = chart.fg_color, width = 1))

    // ---------- Garis Control ----------
    pink = core.controlLine(store, true, swP, swIdx, swT)
    green = core.controlLine(store, false, swP, swIdx, swT)

    

    float lastSwH = na
    float lastSwL = na
    if swP.size() > 0
        for k = swP.size() - 1 to 0
            if swT.get(k) == 1 and na(lastSwH)
                lastSwH := swP.get(k)
            if swT.get(k) == -1 and na(lastSwL)
                lastSwL := swP.get(k)
            if not na(lastSwH) and not na(lastSwL)
                break

    float pinkY = pink.exists ? (inManualPink ? inPinkMan : lastSwH) : na
    float greenY = green.exists ? (inManualGreen ? inGreenMan : lastSwL) : na

    // ---------- Kirim garis control via alert (hanya jika berubah) ----------
    if inSendAlert and pink.exists and green.exists
        if na(lastSentPink) or na(lastSentGreen) or pinkY != lastSentPink or greenY != lastSentGreen
            string payload = '{"symbol":"' + syminfo.tickerid + '","tf":"' + timeframe.period + '","upper":' + str.tostring(pinkY, format.mintick) + ',"lower":' + str.tostring(greenY, format.mintick) + ',"manualUpper":' + str.tostring(inManualPink) + ',"manualLower":' + str.tostring(inManualGreen) + ',"time":' + str.tostring(time) + '}'
            alert(payload, alert.freq_once_per_bar_close)
            lastSentPink := pinkY
            lastSentGreen := greenY

    // ---------- Validasi ulang saat mode manual ----------
    core.ControlLine pinkCl = pink
    if inManualPink and pink.exists
        pinkCl := core.controlLineAt(store, true, swP, swIdx, swT, inPinkMan)

    core.ControlLine greenCl = green
    if inManualGreen and green.exists
        greenCl := core.controlLineAt(store, false, swP, swIdx, swT, inGreenMan)

    // Solid hanya jika zona yang kena benar-benar tergambar di chart
    bool pinkValid = pinkCl.valid
    if pinkValid
        int zidChkP = na(pinkCl.hitIdx) ? -1 : store.baseZone.get(pinkCl.hitIdx)
        pinkValid := zidChkP >= 0 and drawnDbd.includes(zidChkP)

    bool greenValid = greenCl.valid
    if greenValid
        int zidChkG = na(greenCl.hitIdx) ? -1 : store.rbrBaseZone.get(greenCl.hitIdx)
        greenValid := zidChkG >= 0 and drawnRbr.includes(zidChkG)

    // ---------- Titik awal garis: tepi kiri zona DBD / RBR yang kena ----------
    // Jika belum solid (tidak kena zona), tetap mulai dari swing seperti semula.
    int pinkStart = pink.swingIdx
    if pinkValid and not na(pinkCl.hitIdx)
        pinkStart := pinkCl.hitIdx
        int zidP = store.baseZone.get(pinkCl.hitIdx)
        if zidP >= 0 and zidP < store.dbd.size()
            pinkStart := store.dbd.get(zidP).left

    int greenStart = green.swingIdx
    if greenValid and not na(greenCl.hitIdx)
        greenStart := greenCl.hitIdx
        int zidG = store.rbrBaseZone.get(greenCl.hitIdx)
        if zidG >= 0 and zidG < store.rbr.size()
            greenStart := store.rbr.get(zidG).left

    int pinkX = pink.exists ? math.max(pinkStart, minX) : na
    int greenX = green.exists ? math.max(greenStart, minX) : na

    if inShowCtrl and pink.exists
        lns.push(line.new(x1 = pinkX, y1 = pinkY, x2 = bar_index, y2 = pinkY, xloc = xloc.bar_index, extend = extend.right, color = inPinkCol, style = pinkValid ? line.style_solid : line.style_dashed, width = 2))
        if inShowNotes
            lbs.push(label.new(x = bar_index + 3, y = pinkY, xloc = xloc.bar_index, text = core.controlText(store, pinkCl, true), style = label.style_label_lower_left, color = color.new(color.black, 20), textcolor = inPinkCol, textalign = text.align_left, size = size.small))

    if inShowCtrl and green.exists
        lns.push(line.new(x1 = greenX, y1 = greenY, x2 = bar_index, y2 = greenY, xloc = xloc.bar_index, extend = extend.right, color = inGreenCol, style = greenValid ? line.style_solid : line.style_dashed, width = 2))
        if inShowNotes
            lbs.push(label.new(x = bar_index + 3, y = greenY, xloc = xloc.bar_index, text = core.controlText(store, greenCl, false), style = label.style_label_upper_left, color = color.new(color.black, 20), textcolor = inGreenCol, textalign = text.align_left, size = size.small))
    
    // ---------- Zona Entry (25%) ----------
    if pink.exists and green.exists and pinkY > greenY

        int touchUp = 0
        int touchLo = 0

        [topB, botB, tpP] = core.fibZones(pinkY, greenY, 0.25)
        int fibLeft = math.max(pinkX, greenX)
        bxs.push(box.new(left = fibLeft, top = pinkY, right = bar_index, bottom = topB, xloc = xloc.bar_index, extend = extend.right, border_color = color.new(inPinkCol, 100), bgcolor = color.new(inPinkCol, 80)))
        bxs.push(box.new(left = fibLeft, top = botB, right = bar_index, bottom = greenY, xloc = xloc.bar_index, extend = extend.right, border_color = color.new(inGreenCol, 100), bgcolor = color.new(inGreenCol, 80)))
        lns.push(line.new(x1 = fibLeft, y1 = tpP, x2 = bar_index, y2 = tpP, xloc = xloc.bar_index, extend = extend.right, color = color.gray, width = 2))

        for g = 0 to inGapCnt
            float f = g / float(inGapCnt)
            float yUp = pinkY - (pinkY - topB) * f
            float yLo = botB + (greenY - botB) * f
            if high >= yUp
                touchUp := math.max(touchUp, inGapCnt - g + 1)
            if low <= yLo
                touchLo := math.max(touchLo, g + 1)
            lns.push(line.new(x1 = fibLeft, y1 = yUp, x2 = bar_index, y2 = yUp, xloc = xloc.bar_index, extend = extend.right, color = inPinkCol, width = 1))
            lns.push(line.new(x1 = fibLeft, y1 = yLo, x2 = bar_index, y2 = yLo, xloc = xloc.bar_index, extend = extend.right, color = inGreenCol, width = 1))
            lbs.push(label.new(x = fibLeft, y = yUp, xloc = xloc.bar_index, text = str.tostring(inGapCnt - g + 1), style = label.style_label_right, color = color.new(color.black, 50), textcolor = color.white, size = size.small))
            lbs.push(label.new(x = fibLeft, y = yLo, xloc = xloc.bar_index, text = str.tostring(g + 1), style = label.style_label_right, color = color.new(color.black, 50), textcolor = color.white, size = size.small))

        float zoneH = pinkY - topB
        float slUp = pinkY + zoneH * 0.2
        float slLo = greenY - zoneH * 0.2
        lns.push(line.new(x1 = fibLeft, y1 = slUp, x2 = bar_index, y2 = slUp, xloc = xloc.bar_index, extend = extend.right, color = color.red, width = 2))
        lns.push(line.new(x1 = fibLeft, y1 = slLo, x2 = bar_index, y2 = slLo, xloc = xloc.bar_index, extend = extend.right, color = color.red, width = 2))
        lbs.push(label.new(x = fibLeft, y = slUp, xloc = xloc.bar_index, text = 'SL', style = label.style_label_right, color = color.new(color.black, 50), textcolor = color.white, size = size.small))
        lbs.push(label.new(x = fibLeft, y = slLo, xloc = xloc.bar_index, text = 'SL', style = label.style_label_right, color = color.new(color.black, 50), textcolor = color.white, size = size.small))

                // ---------- Memory trader + warning ----------
        // 1) Cut loss: candle yang baru tutup (close[1]) melewati garis control
        if barstate.isnew
            if sellMax > 0 and close[1] > pinkY
                addLog(logS, 'CUT LOSS SELL! candle close di atas control')
                sellMax := 0
                sellLock := true
            if buyMax > 0 and close[1] < greenY
                addLog(logB, 'CUT LOSS BUY! candle close di bawah control')
                buyMax := 0
                buyLock := true

        // 2) Lock dilepas setelah harga benar-benar keluar dari zona
        if touchUp == 0
            sellLock := false
        if touchLo == 0
            buyLock := false

        // 3) Masuk / naik layer
        if not sellLock and touchUp > sellMax
            int prevS = sellMax
            sellMax := touchUp
            addLog(logS, prevS == 0 ? 'SELL masuk garis ' + str.tostring(sellMax) : 'SELL layer naik ke garis ' + str.tostring(sellMax))
            if sellMax >= inTpLayer and prevS < inTpLayer
                addLog(logS, 'SELL garis ' + str.tostring(sellMax) + ': TP di PROXIMAL (garis 1)')

        if not buyLock and touchLo > buyMax
            int prevB = buyMax
            buyMax := touchLo
            addLog(logB, prevB == 0 ? 'BUY masuk garis ' + str.tostring(buyMax) : 'BUY layer naik ke garis ' + str.tostring(buyMax))
            if buyMax >= inTpLayer and prevB < inTpLayer
                addLog(logB, 'BUY garis ' + str.tostring(buyMax) + ': TP di PROXIMAL (garis 1)')

        // 4) TP: pakai harga saat ini
        if sellMax > 0
            bool proxS = sellMax >= inTpLayer
            if close <= (proxS ? topB : tpP)
                addLog(logS, 'TP SELL SEKARANG: harga di ' + (proxS ? 'proximal (garis 1)' : 'garis tengah'))
                sellMax := 0
                sellLock := true

        if buyMax > 0
            bool proxB = buyMax >= inTpLayer
            if close >= (proxB ? botB : tpP)
                addLog(logB, 'TP BUY SEKARANG: harga di ' + (proxB ? 'proximal (garis 1)' : 'garis tengah'))
                buyMax := 0
                buyLock := true

        // 5) Status SELL / BUY (tabel terpisah)
        if inShowTouch
            string upTxt = 'SELL: -'
            string loTxt = 'BUY: -'
            if sellMax > 0
                upTxt := 'SELL AKTIF | max garis ' + str.tostring(sellMax) + ' | TP: ' + (sellMax >= inTpLayer ? 'proximal' : 'garis tengah')
            else if touchUp > 0
                upTxt := 'SELL: selesai, tunggu harga keluar zona'
            if buyMax > 0
                loTxt := 'BUY AKTIF | max garis ' + str.tostring(buyMax) + ' | TP: ' + (buyMax >= inTpLayer ? 'proximal' : 'garis tengah')
            else if touchLo > 0
                loTxt := 'BUY: selesai, tunggu harga keluar zona'
            table.cell(sellTbl, 0, 1, upTxt, text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 30))
            table.cell(buyTbl, 0, 1, loTxt, text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(color.black, 30))

    // ---------- Log berjalan SELL & BUY (terbaru di atas) ----------
    if inShowTouch
        for i = 0 to LOG_ROWS - 1
            string ts = ''
            string tb = ''
            if i < logS.size()
                ts := logS.get(logS.size() - 1 - i)
            if i < logB.size()
                tb := logB.get(logB.size() - 1 - i)
            table.cell(sellTbl, 0, 2 + i, ts, text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = ts == '' ? na : color.new(color.black, 30))
            table.cell(buyTbl, 0, 2 + i, tb, text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = tb == '' ? na : color.new(color.black, 30))